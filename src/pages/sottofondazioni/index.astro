---
import BaseLayout from '../../layouts/BaseLayout.astro';

const contexts = [
  {
    number: '01',
    title: 'Fondazioni esistenti',
    text: 'Una sottofondazione riguarda il rapporto con una struttura già presente. Prima di parlarne servono informazioni su edificio, fondazioni, storia e osservazioni, non soltanto una fotografia di una crepa.',
  },
  {
    number: '02',
    title: 'Terreno e condizioni del sito',
    text: 'Terreno, acqua, scavi, accessibilità e opere vicine possono influire sulla valutazione. Il loro ruolo non si può stabilire online né sostituire con una soluzione standard.',
  },
  {
    number: '03',
    title: 'Collegamento e fasi',
    text: 'Un eventuale progetto deve chiarire come le parti nuove collaborano con quelle esistenti, quali fasi prevede e come vengono controllati gli effetti sull’edificio.',
  },
];

const checklist = [
  'quali segni o cambiamenti hanno portato a chiedere informazioni, indicando posizione, date e ciò che è osservato direttamente;',
  'età dell’edificio, ampliamenti, ristrutturazioni, cambi d’uso e documenti disponibili sulle fondazioni esistenti;',
  'tipo di terreno o informazioni geotecniche che conosci, oltre a acqua, perdite, infiltrazioni, scavi e opere vicine;',
  'fotografie, planimetrie, relazioni, pratiche, ripristini o valutazioni già ricevute, conservando originali e date;',
  'accessi, spazi di lavoro, impianti, occupazione degli ambienti e vincoli che possono incidere sulle fasi di cantiere;',
  'domande su obiettivi, collegamento tra nuovo ed esistente, fasi, controlli, documenti, tempi e adempimenti applicabili.',
];

const processSteps = [
  {
    title: 'Rilevare lo stato di fatto',
    text: 'Si raccolgono osservazioni, storia e documenti per comprendere il sistema esistente. Il rilievo non coincide con una diagnosi ricavata a distanza.',
  },
  {
    title: 'Valutare il rapporto col terreno',
    text: 'Fondazioni, terreno, acqua e carichi possono richiedere verifiche e competenze diverse. La soluzione deve partire dal problema verificato.',
  },
  {
    title: 'Progettare fasi e controlli',
    text: 'Se un intervento è pertinente, il progetto dovrebbe descrivere collegamenti, sequenza delle lavorazioni, controlli, limiti e gestione del cantiere.',
  },
];

const questions = [
  {
    title: 'Quale problema viene affrontato?',
    text: 'Chiedi quale osservazione o verifica sostiene la proposta e quale obiettivo si intende raggiungere, senza confondere il nome dell’opera con la causa.',
  },
  {
    title: 'Come collaborano le parti?',
    text: 'Domanda come il progetto descrive il collegamento tra fondazioni esistenti e nuove, le fasi e i controlli previsti durante le lavorazioni.',
  },
  {
    title: 'Quali condizioni possono cambiare il progetto?',
    text: 'Chiedi quali dati del terreno, dell’edificio, degli accessi o degli impianti siano decisivi e quali alternative o approfondimenti restino possibili.',
  },
];

const attentionPoints = [
  'non iniziare scavi, demolizioni, puntellamenti o lavorazioni sotto le fondazioni come prova domestica;',
  'non rimuovere terreno o parti dell’edificio per cercare di capire la profondità o la forma delle fondazioni;',
  'non entrare in scavi, cantine o zone con acqua, distacchi, gas, cavi esposti o altri elementi che rendono rischioso avvicinarsi;',
  'interrompere la raccolta se per documentare servirebbero macchinari, scale, accessi non sicuri o modifiche all’immobile.',
];

const faq = [
  {
    question: 'Che cosa sono le sottofondazioni?',
    answer: 'È un termine generale per interventi che possono aggiungere o modificare elementi di fondazione in relazione a una struttura esistente. Non indica una tecnica unica e non conferma da solo che l’intervento serva.',
  },
  {
    question: 'Le sottofondazioni servono se ci sono crepe nei muri?',
    answer: 'Non è possibile dirlo da una crepa o da una fotografia. Le fessure possono avere contesti diversi; prima occorre comprendere edificio, fondazioni, terreno, acqua e cronologia.',
  },
  {
    question: 'Le sottofondazioni sono uguali ai micropali?',
    answer: 'No. I micropali possono essere una delle soluzioni considerate in determinati progetti, mentre “sottofondazioni” è un’espressione più ampia. Il confronto dipende dal caso concreto e dal progetto.',
  },
  {
    question: 'Si può fare una sottofondazione senza toccare la casa?',
    answer: 'Ogni lavorazione ha condizioni, fasi e possibili interferenze da valutare. Non è possibile stabilirlo in generale né decidere a distanza senza conoscere edificio, fondazioni e terreno.',
  },
  {
    question: 'Quanto costa una sottofondazione?',
    answer: 'Non esiste un prezzo generale affidabile senza conoscere edificio, lunghezze, accessibilità, terreno, lavorazioni, progetto, controlli e adempimenti. Una cifra standard non dimostra che l’opera sia necessaria.',
  },
  {
    question: 'Posso chiedere un preventivo senza un progetto?',
    answer: 'Puoi chiedere quali dati servano per formulare una proposta, ma un preventivo attendibile dipende dal contesto reale e dalle verifiche necessarie. Il modulo online raccoglie soltanto le osservazioni fornite.',
  },
];
---

<BaseLayout
  title="Sottofondazioni: cosa sono e quando si valutano"
  description="Sottofondazioni: significato, fondazioni esistenti, terreno, fasi e controlli da conoscere senza scegliere online una tecnica o concludere che l’intervento serva."
  canonical="https://crepeincasa.it/sottofondazioni/"
>
  <article class="underpinning-page">
    <header class="underpinning-hero">
      <div class="container underpinning-hero-inner">
        <p class="eyebrow">Guida a fondazioni e interventi</p>
        <h1>Sottofondazioni: cosa sono e quando si valutano</h1>
        <p class="underpinning-lead">
          “Sottofondazioni” indica una possibile categoria di interventi su fondazioni esistenti, non una risposta
          automatica a una crepa o a un dislivello. Prima della scelta vengono rilievi, verifiche, progetto e controlli.
        </p>
        <p class="underpinning-meta">Lettura di circa 8 minuti · Nessuna diagnosi online</p>
      </div>
    </header>

    <div class="container underpinning-layout">
      <aside class="underpinning-index" aria-label="In questa guida">
        <p class="underpinning-index-title">In questa guida</p>
        <nav>
          <a href="#risposta">La risposta breve</a>
          <a href="#contesto">Tre elementi da distinguere</a>
          <a href="#checklist">Cosa preparare</a>
          <a href="#percorso">Il percorso generale</a>
          <a href="#domande">Domande da fare</a>
          <a href="#attenzione">Cosa non fare</a>
          <a href="#faq">Domande frequenti</a>
          <a href="#fonti">Fonti istituzionali</a>
        </nav>
      </aside>

      <div class="underpinning-content">
        <section class="underpinning-section underpinning-intro" id="risposta" aria-labelledby="answer-title">
          <p class="eyebrow">La risposta breve</p>
          <h2 id="answer-title">Il nome dell’intervento non dimostra che sia necessario</h2>
          <p>
            Una sottofondazione può essere descritta, in generale, come un intervento che mette in relazione nuove
            opere con fondazioni esistenti. Il termine non identifica da solo la causa di una fessura né la soluzione per una casa.
          </p>
          <p>
            In un edificio esistente possono contare storia, carichi, fondazioni, terreno, acqua, accessibilità e
            documentazione. Una valutazione riferita all’immobile deve chiarire quali dati e quali verifiche siano pertinenti.
          </p>
          <div class="underpinning-note">
            <strong>Prima si verifica, poi si progetta</strong>
            <p>“Vorrei capire se il problema riguarda il sistema fondale e quali verifiche servano” è una richiesta. “Devo fare una sottofondazione” è una conclusione che non si può ricavare online.</p>
          </div>
        </section>

        <section class="underpinning-section" id="contesto" aria-labelledby="context-title">
          <p class="eyebrow">Possibili elementi di contesto</p>
          <h2 id="context-title">Tre aspetti da valutare insieme</h2>
          <p>
            Questi elementi possono entrare nel progetto, ma non sono test domestici e non permettono di scegliere da
            soli un tipo di opera o una sequenza di lavori.
          </p>
          <div class="underpinning-contexts">
            {contexts.map((item) => (
              <article class="underpinning-context">
                <p class="underpinning-number">{item.number}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="underpinning-section" id="checklist" aria-labelledby="checklist-title">
          <p class="eyebrow">Preparare il confronto</p>
          <h2 id="checklist-title">Checklist prima di parlare di sottofondazioni</h2>
          <p>
            Raccogli informazioni accessibili e documenti disponibili. Se un dato manca, dichiaralo senza sostituirlo
            con un’interpretazione tecnica.
          </p>
          <ul class="underpinning-list">
            {checklist.map((item, index) => (
              <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
            ))}
          </ul>
          <div class="underpinning-limit">
            <strong>Un cantiere non è una verifica preliminare</strong>
            <p>Scavi o lavorazioni iniziati prima di chiarire il problema possono alterare il contesto e introdurre nuovi rischi. Prima chiedi quali verifiche siano necessarie.</p>
          </div>
        </section>

        <section class="underpinning-section" id="percorso" aria-labelledby="process-title">
          <p class="eyebrow">Dal problema al progetto</p>
          <h2 id="process-title">Un percorso generale in tre passaggi</h2>
          <div class="underpinning-steps">
            {processSteps.map((item, index) => (
              <article class="underpinning-step">
                <p class="underpinning-step-number">{String(index + 1).padStart(2, '0')}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
          <p>
            Il percorso concreto cambia in base al tipo di edificio, al terreno, al contesto e agli adempimenti
            applicabili. Questa guida orienta le domande, non sostituisce rilievi, calcoli o autorizzazioni.
          </p>
        </section>

        <section class="underpinning-section" id="domande" aria-labelledby="questions-title">
          <p class="eyebrow">Confronto qualificato</p>
          <h2 id="questions-title">Domande utili prima di accettare una proposta</h2>
          <p>
            Una proposta comprensibile dovrebbe collegare osservazioni, verifiche, obiettivi, collegamenti, fasi e
            controlli. Chiedi spiegazioni sul caso concreto senza dover scegliere tu l’opera.
          </p>
          <div class="underpinning-questions">
            {questions.map((item) => (
              <article class="underpinning-question">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
          <p>
            Per lavori sulle fondazioni esistenti possono essere rilevanti progetto, responsabilità professionali,
            pratiche, controlli e gestione del cantiere: chiedi quali passaggi siano previsti e quali documenti riceverai.
          </p>
        </section>

        <section class="underpinning-section underpinning-alert" id="attenzione" aria-labelledby="attention-title">
          <p class="eyebrow">Prima la sicurezza</p>
          <h2 id="attention-title">Cosa non fare per “controllare” le fondazioni</h2>
          <p>
            Le sottofondazioni richiedono lavorazioni che non sono prove domestiche. Non modificare l’immobile per
            ottenere una risposta più rapida.
          </p>
          <ul class="underpinning-list underpinning-list-plain">
            {attentionPoints.map((item) => <li><span aria-hidden="true">—</span><p>{item}</p></li>)}
          </ul>
          <p>
            In condizioni che potrebbero richiedere attenzione urgente, allontanati se necessario e rivolgiti
            tempestivamente a un professionista qualificato o alle autorità competenti. Per il contesto delle verifiche
            post-sisma, consulta la <a href="https://www.protezionecivile.gov.it/it/approfondimento/scheda-aedes/" target="_blank" rel="noreferrer">scheda AeDES</a>
            del Dipartimento della Protezione Civile. Questo sito non è un servizio di emergenza.
          </p>
        </section>

        <section class="underpinning-section underpinning-faq" id="faq" aria-labelledby="faq-title">
          <p class="eyebrow">Domande frequenti</p>
          <h2 id="faq-title">Sottofondazioni</h2>
          <div class="underpinning-faq-list">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="underpinning-sources" id="fonti" aria-labelledby="sources-title">
          <p class="eyebrow">Per approfondire</p>
          <h2 id="sources-title">Fonti istituzionali sulle fondazioni esistenti</h2>
          <p>
            Le fonti seguenti descrivono norme e procedure generali. Non sono strumenti per decidere online se una
            sottofondazione sia necessaria e non sostituiscono un progetto o una valutazione professionale.
          </p>
          <ul>
            <li><a href="https://www.gazzettaufficiale.it/atto/serie_generale/caricaArticoloDefault/originario?atto.codiceRedazionale=19A00855&amp;atto.dataPubblicazioneGazzetta=2019-02-11&amp;atto.tipoProvvedimento=CIRCOLARE" target="_blank" rel="noreferrer">Gazzetta Ufficiale — Circolare applicativa delle Norme tecniche</a></li>
            <li><a href="https://www.gazzettaufficiale.it/atto/serie_generale/caricaArticoloDefault/originario?atto.codiceRedazionale=18A00716&amp;atto.dataPubblicazioneGazzetta=2018-02-20" target="_blank" rel="noreferrer">Gazzetta Ufficiale — Norme tecniche per le costruzioni</a></li>
            <li><a href="https://www.protezionecivile.gov.it/it/approfondimento/scheda-aedes/" target="_blank" rel="noreferrer">Dipartimento della Protezione Civile — Scheda AeDES</a></li>
          </ul>
        </section>

        <section class="underpinning-related" aria-labelledby="related-title">
          <p class="eyebrow">Continua il percorso</p>
          <h2 id="related-title">Dal vocabolario alla verifica</h2>
          <p>
            Se stai cercando una soluzione perché hai notato una fessurazione o un cambiamento, puoi prima raccogliere
            il contesto e poi preparare una richiesta neutra.
          </p>
          <div class="underpinning-links">
            <a href="/consolidamento-fondazioni/">Consolidamento fondazioni: quando si valuta <span aria-hidden="true">→</span></a>
            <a href="/micropali-fondazioni/">Micropali per fondazioni: cosa sapere <span aria-hidden="true">→</span></a>
            <a href="/resine-espandenti-fondazioni/">Resine espandenti per fondazioni: cosa sapere <span aria-hidden="true">→</span></a>
            <a href="/cedimento-fondazioni/">Cedimento delle fondazioni: cosa osservare <span aria-hidden="true">→</span></a>
            <a href="/richiedi-valutazione/">Prepara una richiesta neutra <span aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .underpinning-page { background: var(--paper); }
  .underpinning-hero { border-bottom: 1px solid var(--line); background: var(--surface); }
  .underpinning-hero-inner { padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5.5rem); }
  .underpinning-hero h1 { max-width: 14ch; font-size: clamp(3rem, 7vw, 6rem); }
  .underpinning-lead { max-width: 44rem; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1.12rem, 2vw, 1.4rem); line-height: 1.65; }
  .underpinning-meta { margin: 1.5rem 0 0; color: var(--soft-muted); font-size: 0.82rem; }
  .underpinning-layout { display: grid; grid-template-columns: 12rem minmax(0, 46rem); gap: clamp(2rem, 7vw, 7rem); align-items: start; padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 10vw, 9rem); }
  .underpinning-index { position: sticky; top: 1.5rem; padding-top: 0.35rem; }
  .underpinning-index-title { margin: 0 0 1rem; color: var(--brand-dark); font-size: 0.78rem; font-weight: 800; }
  .underpinning-index nav { display: grid; gap: 0.7rem; }
  .underpinning-index a { color: var(--soft-muted); font-size: 0.78rem; line-height: 1.35; text-decoration: none; }
  .underpinning-index a:hover, .underpinning-index a:focus-visible { color: var(--accent); }
  .underpinning-content { min-width: 0; }
  .underpinning-section { padding-block: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid var(--line); }
  .underpinning-intro { padding-top: 0; border-top: 0; }
  .underpinning-section h2, .underpinning-sources h2, .underpinning-related h2 { max-width: 20ch; font-size: clamp(2.1rem, 4.5vw, 4rem); }
  .underpinning-section > p:not(.eyebrow), .underpinning-sources > p:not(.eyebrow), .underpinning-related > p:not(.eyebrow) { max-width: 42rem; margin: 1.4rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .underpinning-section > p + p:not(.eyebrow) { margin-top: 1rem; }
  .underpinning-section a, .underpinning-sources a { color: var(--brand); text-underline-offset: 0.2em; }
  .underpinning-note, .underpinning-limit { margin-top: 2rem; padding: 1.5rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }
  .underpinning-note strong, .underpinning-limit strong { color: var(--brand-dark); }
  .underpinning-note p, .underpinning-limit p { max-width: 38rem; margin: 0.6rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .underpinning-contexts, .underpinning-steps, .underpinning-questions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .underpinning-context, .underpinning-step, .underpinning-question { padding: 1.5rem; background: var(--surface); }
  .underpinning-number, .underpinning-step-number { margin: 0 0 1.3rem; color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1.1rem; }
  .underpinning-context h3, .underpinning-step h3, .underpinning-question h3 { margin: 0; color: var(--brand-dark); font-size: 1.15rem; letter-spacing: -0.03em; }
  .underpinning-context p:last-child, .underpinning-step p:last-child, .underpinning-question p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .underpinning-list { display: grid; gap: 0.9rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .underpinning-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.9rem; align-items: start; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .underpinning-list li > span { color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; }
  .underpinning-list p { margin: 0; color: var(--ink); font-size: 0.98rem; line-height: 1.6; }
  .underpinning-list-plain li { grid-template-columns: 1rem 1fr; }
  .underpinning-alert { padding: clamp(2rem, 5vw, 3.5rem); border: 0; border-radius: 1rem; background: var(--accent-soft); }
  .underpinning-alert + .underpinning-section { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .underpinning-faq-list { margin-top: 2rem; border-top: 1px solid var(--line); }
  .underpinning-faq-list details { border-bottom: 1px solid var(--line); }
  .underpinning-faq-list summary { padding: 1.25rem 2rem 1.25rem 0; color: var(--brand-dark); cursor: pointer; font-weight: 750; list-style-position: outside; }
  .underpinning-faq-list p { max-width: 40rem; margin: -0.4rem 0 1.25rem; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }
  .underpinning-sources, .underpinning-related { margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 1rem; }
  .underpinning-sources { background: var(--surface); border: 1px solid var(--line); }
  .underpinning-sources ul { display: grid; gap: 0.7rem; margin: 1.5rem 0 0; padding-left: 1.2rem; color: var(--muted); line-height: 1.6; }
  .underpinning-related { background: var(--surface-alt); }
  .underpinning-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem 1.5rem; margin-top: 1.6rem; }
  .underpinning-links a { color: var(--brand); font-size: 0.88rem; font-weight: 750; }
  .underpinning-links a span { color: var(--accent); text-decoration: none; }

  @media (max-width: 820px) {
    .underpinning-layout { grid-template-columns: 1fr; }
    .underpinning-index { position: static; padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .underpinning-index nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .underpinning-index a { font-size: 0.82rem; }
    .underpinning-contexts, .underpinning-steps, .underpinning-questions { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .underpinning-hero h1 { font-size: clamp(2.8rem, 14vw, 4.8rem); }
    .underpinning-links { grid-template-columns: 1fr; }
  }
</style>
