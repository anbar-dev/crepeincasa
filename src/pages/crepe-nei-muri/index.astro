---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { supportingGuides } from '../../data/supportingGuides';

const primaryGuides = supportingGuides.slice(0, 3);
const secondaryGuides = supportingGuides.slice(3);

const possibleCauses = [
  {
    title: 'Movimenti e assestamenti',
    text: 'Nel tempo un edificio e i suoi materiali possono cambiare. Umidità, temperatura e normali movimenti possono interessare alcuni elementi, ma non spiegano automaticamente ogni crepa.',
  },
  {
    title: 'Materiali e finiture',
    text: 'La linea può trovarsi nell’intonaco, nella tinteggiatura o in un altro strato superficiale. Dalla sola vista non si può stabilire che cosa ci sia sotto.',
  },
  {
    title: 'Acqua e ambiente',
    text: 'Infiltrazioni, umidità e cambiamenti nel deflusso dell’acqua sono elementi da mettere in relazione con la storia della casa e con ciò che si vede.',
  },
  {
    title: 'Lavori o modifiche recenti',
    text: 'Ristrutturazioni, aperture, chiusure di vani e altri lavori possono aver cambiato il contesto. Il loro ruolo va valutato sul posto, non dato per scontato.',
  },
];

const observations = [
  'Dove si trova: parete interna o esterna, soffitto, pavimento, angolo, porta o finestra.',
  'Che cosa si vede intorno: finiture, giunti, rivestimenti o altri elementi collegati alla zona.',
  'Quando l’hai notata e se ti sembra diversa rispetto a prima.',
  'Se ci sono infiltrazioni, distacchi di finitura, porte o finestre che funzionano diversamente dal solito.',
  'Se ci sono stati lavori recenti, cambiamenti nell’uso dei locali o eventi ambientali da riferire.',
];

const interventions = [
  'ripristino di intonaci, finiture o rivestimenti, quando il problema riguarda gli strati superficiali;',
  'interventi per gestire umidità o acqua, se questo aspetto viene confermato come rilevante;',
  'opere locali o di riparazione, definite in base all’elemento coinvolto e alle sue condizioni;',
  'soluzioni che interessano terreno, fondazioni o altri elementi dell’edificio, solo quando una valutazione tecnica ne chiarisce la necessità e la fattibilità.',
];
---

<BaseLayout
  title="Crepe nei muri: capire il problema e sapere come muoversi"
  description="Una guida chiara alle crepe nei muri: possibili contesti, cosa può aiutare a capire il problema e quando chiedere una valutazione sul posto."
  canonical="https://crepeincasa.it/crepe-nei-muri/"
>
  <article class="article-page">
    <header class="article-hero">
      <div class="container article-hero-inner">
        <p class="eyebrow">Guida pratica</p>
        <h1 id="article-title">Crepe nei muri: da dove partire per capire il problema</h1>
        <p class="article-lead">
          Una crepa può avere cause diverse e non si può classificare da una fotografia. Qui trovi
          un modo chiaro per inquadrare la situazione e capire quando conviene chiedere un sopralluogo.
        </p>
        <p class="article-meta">Tempo di lettura: circa 7 minuti</p>
      </div>
    </header>

    <div class="container article-layout">
      <aside class="article-index" aria-label="In questa guida">
        <p class="article-index-title">In questa guida</p>
        <nav>
          <a href="#risposta-breve">La risposta breve</a>
          <a href="#cause">Che cosa può esserci dietro</a>
          <a href="#osservare">I fatti che contano</a>
          <a href="#verifica">Quando chiedere un sopralluogo</a>
          <a href="#faq">Domande frequenti</a>
        </nav>
      </aside>

      <div class="article-content">
        <section id="risposta-breve" class="article-section" aria-labelledby="risposta-title">
          <p class="eyebrow">In breve</p>
          <h2 id="risposta-title">Una crepa non dice da sola qual è la causa</h2>
          <p>
            Una crepa è una discontinuità visibile in una finitura o in un elemento dell’edificio.
            La parola descrive un segno, non spiega perché sia comparso: possono entrare in gioco
            materiali, umidità, movimenti, lavori o più fattori insieme.
          </p>
          <p>
            Una fotografia o una descrizione online non mostra tutto ciò che serve per valutare la
            casa. Se devi capire l’origine del problema o decidere come intervenire, serve un
            professionista che esamini l’immobile sul posto.
          </p>
        </section>

        <section id="cause" class="article-section" aria-labelledby="cause-title">
          <p class="eyebrow">Per orientarsi</p>
          <h2 id="cause-title">Che cosa può esserci dietro una crepa</h2>
          <p>
            Queste sono le principali aree che un professionista può mettere in relazione. Non sono
            una diagnosi e non indicano quale intervento serva nella tua casa.
          </p>
          <div class="article-cards">
            {possibleCauses.map((cause) => (
              <article class="article-card">
                <h3>{cause.title}</h3>
                <p>{cause.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section id="osservare" class="article-section" aria-labelledby="observe-title">
          <p class="eyebrow">Per inquadrare il problema</p>
          <h2 id="observe-title">I fatti che aiutano a capire la situazione</h2>
          <p>
            Non servono strumenti speciali né termini tecnici. Bastano pochi elementi concreti per
            spiegare bene il problema a chi dovrà valutarlo.
          </p>
          <ul class="article-list">
            {observations.map((observation, index) => (
              <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{observation}</p></li>
            ))}
          </ul>
          <div class="note-box">
            <strong>Un accorgimento utile</strong>
            <p>
              Se hai fotografie, porta sia una vista dell’ambiente sia un dettaglio della crepa.
              La data e le immagini originali aiutano a ricostruire la situazione.
            </p>
          </div>
        </section>

        <section class="article-section article-limit" aria-labelledby="limits-title">
          <p class="eyebrow">Un limite importante</p>
          <h2 id="limits-title">Che cosa non si può stabilire online</h2>
          <p>
            Da testo, fotografie o questionari non si può concludere che una crepa sia strutturale,
            che esista un cedimento, che l’edificio sia sicuro o pericoloso, oppure che serva una tecnica
            specifica. La stessa descrizione può richiedere valutazioni diverse in contesti diversi.
          </p>
          <p>
            Se noti condizioni che potrebbero richiedere attenzione urgente, allontanati dalla zona se
            necessario e rivolgiti tempestivamente a un professionista qualificato o alle autorità
            competenti. Le informazioni di questa pagina non sostituiscono una valutazione sul posto.
          </p>
        </section>

        <section id="verifica" class="article-section" aria-labelledby="check-title">
          <p class="eyebrow">Il passo successivo</p>
          <h2 id="check-title">Quando è il momento di chiedere un sopralluogo</h2>
          <p>
            Chiedi un sopralluogo se il problema persiste, cambia nel tempo, compare insieme ad altri
            segnali o se devi decidere come procedere con un ripristino o un lavoro.
          </p>
          <p>
            Durante il sopralluogo il tecnico può esaminare materiali, posizione, storia dell’edificio,
            lavori recenti e rapporto con gli altri elementi. Solo a quel punto può indicare se servono
            ulteriori controlli o quale tipo di intervento abbia senso valutare.
          </p>
        </section>

        <section class="article-section" aria-labelledby="interventions-title">
          <p class="eyebrow">Panoramica</p>
          <h2 id="interventions-title">Quali soluzioni possono entrare in gioco</h2>
          <p>
            Non esiste un rimedio universale. In base a ciò che emerge dal sopralluogo, il professionista
            può valutare, per esempio:
          </p>
          <ul class="article-list article-list-plain">
            {interventions.map((intervention) => (
              <li><span aria-hidden="true">—</span><p>{intervention}</p></li>
            ))}
          </ul>
          <p>
            L’elenco non è una raccomandazione per il tuo caso. Prima di accettare lavori, fatti spiegare
            quale problema risolvono, su quali verifiche si basano e quali alternative esistono.
          </p>
        </section>

        <section id="faq" class="article-section article-faq" aria-labelledby="faq-title">
          <p class="eyebrow">Domande frequenti</p>
          <h2 id="faq-title">Crepe nei muri: le domande più comuni</h2>
          <div class="faq-list">
            <details>
              <summary>Una crepa è sempre un problema strutturale?</summary>
              <p>No. La forma visibile non basta: possono essere coinvolti strati superficiali o altri fattori. Solo una valutazione sul posto può chiarire il caso concreto.</p>
            </details>
            <details>
              <summary>Una foto può bastare per capire la causa?</summary>
              <p>Una foto aiuta a mostrare il segno, ma non mostra tutto il contesto e non sostituisce un sopralluogo quando devi capire la causa o decidere come intervenire.</p>
            </details>
            <details>
              <summary>Devo misurare la crepa?</summary>
              <p>Non è necessario fare prove improvvisate. Se hai una misura ottenuta senza rischi puoi riferirla, ma posizione, data e cambiamenti sono spesso più utili per iniziare.</p>
            </details>
            <details>
              <summary>Chi può valutare una crepa nell’immobile?</summary>
              <p>Un professionista qualificato può valutare il caso sul posto e indicare quali controlli siano appropriati rispetto al contesto.</p>
            </details>
          </div>
        </section>

        <section class="related-content" aria-labelledby="related-title">
          <div>
            <p class="eyebrow">Approfondisci il contesto</p>
            <h2 id="related-title">Da quale guida continuare</h2>
            <p>Scegli la pagina che assomiglia di più al problema che devi risolvere. Se vuoi passare direttamente a un confronto, puoi inviare una richiesta.</p>
            <nav class="cluster-link-grid" aria-label="Percorso consigliato sulle crepe">
              {primaryGuides.map((page) => (
                <a href={page.href}>
                  <span class="cluster-link-title">{page.title}<span class="cluster-link-arrow" aria-hidden="true">→</span></span>
                  <small>{page.description}</small>
                </a>
              ))}
            </nav>
            <details class="secondary-guides">
              <summary>Vedi altre guide per situazioni specifiche</summary>
              <nav class="cluster-link-grid" aria-label="Altre guide sulle crepe">
                {secondaryGuides.map((page) => (
                  <a href={page.href}>
                    <span class="cluster-link-title">{page.title}<span class="cluster-link-arrow" aria-hidden="true">→</span></span>
                    <small>{page.description}</small>
                  </a>
                ))}
              </nav>
            </details>
          </div>
        </section>

        <aside class="article-cta" aria-labelledby="cta-title">
          <p class="eyebrow">Un aiuto pratico</p>
          <h2 id="cta-title">Vuoi capire come procedere nel tuo caso?</h2>
          <p>Racconta il problema con parole semplici e chiedi un confronto sul posto. Non devi scegliere una tecnica né formulare una diagnosi.</p>
          <a class="inline-link" href="/richiedi-valutazione/">Chiedi una valutazione <span aria-hidden="true">→</span></a>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .article-page { background: var(--paper); }
  .article-hero { border-bottom: 1px solid var(--line); background: var(--surface); }
  .article-hero-inner { padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5.5rem); }
  .article-hero h1 { max-width: 16ch; font-size: clamp(3.1rem, 7vw, 6.4rem); }
  .article-lead { max-width: 43rem; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1.12rem, 2vw, 1.4rem); line-height: 1.65; }
  .article-meta { margin: 1.5rem 0 0; color: var(--soft-muted); font-size: 0.82rem; }
  .article-layout { display: grid; grid-template-columns: 12rem minmax(0, 46rem); gap: clamp(2rem, 7vw, 7rem); align-items: start; padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 10vw, 9rem); }
  .article-index { position: sticky; top: 1.5rem; padding-top: 0.35rem; }
  .article-index-title { margin: 0 0 1rem; color: var(--brand-dark); font-size: 0.78rem; font-weight: 800; }
  .article-index nav { display: grid; gap: 0.7rem; }
  .article-index a { color: var(--soft-muted); font-size: 0.78rem; line-height: 1.35; text-decoration: none; }
  .article-index a:hover, .article-index a:focus-visible { color: var(--accent); }
  .article-content { min-width: 0; }
  .article-section { padding-block: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid var(--line); }
  .article-section:first-child { padding-top: 0; border-top: 0; }
  .article-section h2, .related-content h2, .article-cta h2 { max-width: 20ch; font-size: clamp(2.1rem, 4.5vw, 4rem); }
  .article-section > p:not(.eyebrow), .article-cta > p:not(.eyebrow), .related-content p:not(.eyebrow) { max-width: 42rem; margin: 1.4rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .article-section > p + p:not(.eyebrow) { margin-top: 1rem; }
  .article-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .article-card { padding: 1.5rem; background: var(--surface); }
  .article-card h3 { margin: 0; color: var(--brand-dark); font-size: 1.15rem; letter-spacing: -0.03em; }
  .article-card p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .article-list { display: grid; gap: 0.9rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .article-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.9rem; align-items: start; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .article-list li > span { color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; }
  .article-list p { margin: 0; color: var(--ink); font-size: 0.98rem; line-height: 1.6; }
  .note-box { margin-top: 2rem; padding: 1.5rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }
  .note-box strong { color: var(--brand-dark); }
  .note-box p { max-width: 38rem; margin: 0.6rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .article-limit { padding: clamp(2rem, 5vw, 3.5rem); border: 0; border-radius: 1rem; background: var(--accent-soft); }
  .article-limit + .article-section { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .article-list-plain li { grid-template-columns: 1rem 1fr; }
  .faq-list { margin-top: 2rem; border-top: 1px solid var(--line); }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { padding: 1.25rem 2rem 1.25rem 0; color: var(--brand-dark); cursor: pointer; font-weight: 750; list-style-position: outside; }
  .faq-list p { max-width: 40rem; margin: -0.4rem 0 1.25rem; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }
  .related-content, .article-cta { margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 1rem; }
  .related-content { background: var(--surface-alt); }
  .cluster-link-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.75rem; margin-top: 1.6rem; }
  .cluster-link-grid a { display: block; padding: 1rem; border: 1px solid var(--line); border-radius: 0.75rem; background: var(--surface); color: var(--brand); font-size: 0.88rem; font-weight: 750; text-decoration: none; }
  .cluster-link-grid a:hover, .cluster-link-grid a:focus-visible { border-color: var(--brand); background: var(--paper); }
  .cluster-link-title { display: flex; align-items: start; justify-content: space-between; gap: 0.75rem; }
  .cluster-link-arrow { flex: 0 0 auto; color: var(--accent); text-decoration: none; }
  .cluster-link-grid small { display: block; margin-top: 0.55rem; color: var(--muted); font-size: 0.8rem; font-weight: 500; line-height: 1.45; }
  .secondary-guides { margin-top: 1.4rem; }
  .secondary-guides summary { color: var(--brand); cursor: pointer; font-size: 0.9rem; font-weight: 750; text-underline-offset: 0.2em; }
  .secondary-guides[open] summary { margin-bottom: 1.2rem; }
  .article-cta { background: var(--brand-dark); }
  .article-cta h2 { color: var(--paper); }
  .article-cta .eyebrow { color: #e6a47c; }
  .article-cta > p:not(.eyebrow) { color: #cbd8cf; }
  .article-cta .inline-link { color: var(--paper); }
  .article-cta .inline-link:hover, .article-cta .inline-link:focus-visible { color: #e6a47c; }

  @media (max-width: 820px) {
    .article-layout { grid-template-columns: 1fr; }
    .article-index { position: static; padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .article-index nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .article-index a { font-size: 0.82rem; }
  }

  @media (max-width: 620px) {
    .article-hero h1 { font-size: clamp(2.8rem, 14vw, 4.8rem); }
    .article-cards { grid-template-columns: 1fr; }
    .cluster-link-grid { grid-template-columns: 1fr; }
  }
</style>
