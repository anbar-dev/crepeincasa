---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const steps = [
  {
    number: '01',
    title: 'Fermati prima di intervenire',
    text: 'Non coprire subito il segno e non fare prove sulla superficie. Prima raccogli ciò che puoi osservare senza esporti a rischi.',
  },
  {
    number: '02',
    title: 'Descrivi il contesto',
    text: 'Annota stanza, parete, posizione, finitura, rapporto con porte o finestre e tutto ciò che è successo di recente.',
  },
  {
    number: '03',
    title: 'Documenta nel tempo',
    text: 'Scatta una vista dell’ambiente e un dettaglio, conserva le date e indica soltanto i cambiamenti che hai realmente notato.',
  },
  {
    number: '04',
    title: 'Scegli il prossimo passo',
    text: 'Se la situazione persiste, cambia o richiede una valutazione riferita all’immobile, prepara le informazioni per un professionista qualificato.',
  },
];

const facts = [
  'In quale locale si trova e su quale parete, soffitto o pavimento.',
  'Se la superficie è interna o esterna e quale finitura si vede.',
  'Dove inizia e termina la linea, se è facile descriverlo senza fare prove.',
  'Quando l’hai notata e se hai osservato cambiamenti nel tempo.',
  'Se sono presenti acqua, umidità, distacchi o altri elementi visibili.',
  'Se ci sono stati lavori, fori, modifiche o cambiamenti d’uso recenti.',
];

const avoid = [
  {
    title: 'Non trasformare la forma in una diagnosi',
    text: 'Dire che una crepa è diagonale, verticale o orizzontale descrive un andamento. Non basta per stabilire quale strato sia coinvolto o quale sia la causa.',
  },
  {
    title: 'Non alterare ciò che vuoi documentare',
    text: 'Evita di raschiare, forare, allargare o coprire il segno prima di aver raccolto le informazioni che possono servire a ricostruire il contesto.',
  },
  {
    title: 'Non scegliere una tecnica a distanza',
    text: 'Ripristino, gestione dell’acqua, opere locali o interventi su terreno e fondazioni dipendono dal caso concreto e da una verifica qualificata.',
  },
];

const requestItems = [
  'Comune, provincia e tipologia dell’immobile.',
  'Stanza o zona interessata, con posizione rispetto ad angoli, aperture e altri elementi.',
  'Data della prima osservazione e cronologia dei cambiamenti percepiti.',
  'Fotografie datate, con una vista ampia e un dettaglio della superficie.',
  'Lavori recenti, infiltrazioni, umidità o modifiche che ricordi.',
  'Domande che vuoi portare al professionista, senza dover formulare una conclusione.',
];

const faq = [
  {
    question: 'Devo riparare subito una crepa nel muro?',
    answer: 'Prima di un ripristino è utile documentare ciò che osservi, se farlo è sicuro. La scelta del momento e del tipo di riparazione dipende dal contesto reale; una pagina online non può stabilirlo per il tuo immobile.',
  },
  {
    question: 'Una crepa diagonale è più preoccupante di una verticale?',
    answer: 'La direzione è un dato da descrivere, non una classificazione affidabile della causa o della sicurezza dell’edificio. Servono posizione, materiali, storia e una valutazione sul posto quando necessaria.',
  },
  {
    question: 'Una fotografia può bastare per capire che cosa sta succedendo?',
    answer: 'Una fotografia può documentare un’osservazione, ma non mostra sempre il contesto, gli strati o la storia dell’immobile. Può accompagnare una richiesta, non sostituire una verifica.',
  },
  {
    question: 'Devo misurare la larghezza della crepa?',
    answer: 'Puoi annotare una dimensione solo se riesci a farlo in modo semplice e senza rischi, ma non è necessario fare prove improvvisate. Posizione, data, fotografie e cambiamenti percepiti sono già informazioni utili.',
  },
  {
    question: 'A chi posso chiedere una verifica?',
    answer: 'Un professionista qualificato può esaminare l’immobile sul posto e indicare quali controlli siano appropriati. Se noti condizioni che potrebbero richiedere attenzione urgente, chiedi tempestivamente supporto competente o alle autorità competenti.',
  },
];
---

<BaseLayout
  title="Crepe nei muri: cosa fare dopo averne notata una"
  description="Crepe nei muri: cosa fare, cosa osservare, come documentare la situazione e quando può essere utile chiedere una verifica professionale."
  canonical="https://crepeincasa.it/crepe-nei-muri/cosa-fare/"
>
  <article class="action-page">
    <header class="action-hero">
      <div class="container action-hero-inner">
        <p class="eyebrow">Guida pratica</p>
        <h1 id="page-title">Crepe nei muri: cosa fare dopo averne notata una</h1>
        <p class="action-lead">
          La prima cosa da fare non è indovinare la causa. È mettere in ordine ciò che vedi,
          documentare il contesto e capire se può essere utile una verifica sul posto.
        </p>
        <p class="action-meta">Lettura di circa 8 minuti · Nessuna diagnosi online</p>
      </div>
    </header>

    <div class="container action-layout">
      <aside class="action-index" aria-label="In questa guida">
        <p class="action-index-title">In questa guida</p>
        <nav>
          <a href="#subito">Cosa fare subito</a>
          <a href="#osservazioni">Cosa annotare</a>
          <a href="#documentare">Come documentare</a>
          <a href="#evitare">Cosa evitare</a>
          <a href="#verifica">Quando chiedere una verifica</a>
          <a href="#faq">Domande frequenti</a>
        </nav>
      </aside>

      <div class="action-content">
        <section class="action-section action-intro" id="subito" aria-labelledby="subito-title">
          <p class="eyebrow">La risposta breve</p>
          <h2 id="subito-title">Osserva, documenta, poi decidi il passo successivo</h2>
          <p>
            Una crepa può riguardare una finitura, un rivestimento o altri elementi dell’edificio,
            e può avere contesti diversi. Dalla sola forma o da una fotografia non è possibile
            stabilirne l’origine.
          </p>
          <p>
            Se la situazione lo consente, procedi con calma: non modificare la superficie, raccogli
            informazioni concrete e conserva fotografie datate. Se invece noti distacchi, caduta di
            materiale o condizioni che potrebbero richiedere attenzione urgente, evita la zona e
            rivolgiti tempestivamente a un professionista qualificato o alle autorità competenti.
          </p>
        </section>

        <section class="action-section" aria-labelledby="steps-title">
          <p class="eyebrow">Un percorso semplice</p>
          <h2 id="steps-title">Quattro passi per non perdere il contesto</h2>
          <div class="action-steps">
            {steps.map((step) => (
              <article class="action-step">
                <p class="action-step-number">{step.number}</p>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="action-section" id="osservazioni" aria-labelledby="observations-title">
          <p class="eyebrow">Prima di interpretare</p>
          <h2 id="observations-title">Quali informazioni puoi annotare</h2>
          <p>
            Scrivi ciò che hai visto o ricordato, separandolo dalle ipotesi. Non servono termini
            tecnici: una descrizione concreta aiuta a ricostruire il quadro senza anticipare una
            conclusione.
          </p>
          <ul class="action-list">
            {facts.map((fact, index) => (
              <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{fact}</p></li>
            ))}
          </ul>
          <div class="action-note">
            <strong>Un esempio di descrizione neutra</strong>
            <p>
              “Nel soggiorno, sulla parete vicino alla finestra, ho notato una linea sull’intonaco.
              L’ho fotografata il 7 agosto e non so se fosse già presente. A giugno è stata tinteggiata
              la parete.”
            </p>
          </div>
        </section>

        <section class="action-section" id="documentare" aria-labelledby="document-title">
          <p class="eyebrow">Fotografie e cronologia</p>
          <h2 id="document-title">Come documentare senza fare prove improvvisate</h2>
          <p>
            Le fotografie sono più utili quando conservano il rapporto tra il segno e l’ambiente.
            Puoi creare una piccola cronologia personale, senza presentarla come una misurazione
            tecnica.
          </p>
          <div class="action-cards">
            <article class="action-card">
              <h3>Una vista ampia</h3>
              <p>Mostra il locale o la parete e la posizione della crepa rispetto ad angoli, aperture e altri elementi.</p>
            </article>
            <article class="action-card">
              <h3>Un dettaglio</h3>
              <p>Avvicinati solo quanto basta per rendere leggibile ciò che si vede, senza toccare o rimuovere materiale.</p>
            </article>
            <article class="action-card">
              <h3>La data</h3>
              <p>Conserva la data dello scatto e annota luce, acqua, lavori o altre condizioni che possono cambiare il confronto.</p>
            </article>
            <article class="action-card">
              <h3>Lo stesso punto di vista</h3>
              <p>Se scatti altre foto, prova a mantenere un’inquadratura simile: prospettiva e luce possono modificare l’impressione.</p>
            </article>
          </div>
        </section>

        <section class="action-section" id="evitare" aria-labelledby="avoid-title">
          <p class="eyebrow">Errori frequenti</p>
          <h2 id="avoid-title">Cosa è meglio non fare prima di capire il contesto</h2>
          <div class="action-cards action-cards-plain">
            {avoid.map((item) => (
              <article class="action-card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
          <div class="action-warning">
            <strong>La sicurezza viene prima della documentazione</strong>
            <p>
              Non salire su mobili o scale instabili per fotografare e non avvicinarti a materiale
              che sembra distaccato. Se l’osservazione non è sicura, interrompila e chiedi supporto.
            </p>
          </div>
        </section>

        <section class="action-section action-limit" aria-labelledby="limit-title">
          <p class="eyebrow">Un limite importante</p>
          <h2 id="limit-title">Online non si può stabilire la causa della crepa</h2>
          <p>
            Testo, immagini e questionari possono aiutare a preparare una richiesta, ma non bastano
            per concludere che una crepa sia strutturale, che esista un cedimento, che l’edificio sia
            sicuro o pericoloso oppure che serva una tecnica specifica.
          </p>
          <p>
            Anche termini come “diagonale”, “passante” o “profonda” vanno usati soltanto per riportare
            ciò che è stato osservato o riferito, non come etichette tecniche assegnate online.
          </p>
        </section>

        <section class="action-section" id="verifica" aria-labelledby="verification-title">
          <p class="eyebrow">Il prossimo passo</p>
          <h2 id="verification-title">Quando può essere utile chiedere una verifica</h2>
          <p>
            Può essere ragionevole preparare un confronto sul posto se la situazione persiste, se
            noti cambiamenti, se compare insieme ad altri fenomeni che non sai interpretare o se hai
            bisogno di una valutazione riferita all’immobile reale.
          </p>
          <p>
            La richiesta non deve contenere una diagnosi. È sufficiente raccontare dove si trova il
            segno, che cosa hai osservato, quando lo hai notato e quali informazioni sul contesto sono
            disponibili.
          </p>
          <div class="action-request">
            <h3>Prepara queste informazioni</h3>
            <ul class="action-list action-list-compact">
              {requestItems.map((item) => <li><span aria-hidden="true">✓</span><p>{item}</p></li>)}
            </ul>
          </div>
        </section>

        <section class="action-section" id="faq" aria-labelledby="faq-title">
          <p class="eyebrow">Domande frequenti</p>
          <h2 id="faq-title">Crepe nei muri: cosa fare, in pratica</h2>
          <div class="action-faq">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="action-related" aria-labelledby="related-title">
          <p class="eyebrow">Per approfondire</p>
          <h2 id="related-title">Parti dalla guida generale sulle crepe</h2>
          <p>
            Se vuoi capire meglio quali elementi osservare e quali limiti ha una valutazione online,
            puoi leggere la guida principale prima di preparare il riepilogo.
          </p>
          <div class="action-related-links">
            <a href="/crepe-nei-muri/">Leggi la guida sulle crepe nei muri <span aria-hidden="true">→</span></a>
            <a href="/crepe-nei-muri/quando-chiedere-verifica/">Quando chiedere una verifica <span aria-hidden="true">→</span></a>
            <a href="/crepe-nei-muri/casa-nuova-dopo-lavori/">Casa nuova o dopo lavori <span aria-hidden="true">→</span></a>
            <a href="/richiedi-valutazione/">Prepara una richiesta neutra <span aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .action-page { background: var(--paper); }
  .action-hero { border-bottom: 1px solid var(--line); background: var(--surface); }
  .action-hero-inner { padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5.5rem); }
  .action-hero h1 { max-width: 15ch; font-size: clamp(3rem, 7vw, 6rem); }
  .action-lead { max-width: 44rem; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1.12rem, 2vw, 1.4rem); line-height: 1.65; }
  .action-meta { margin: 1.5rem 0 0; color: var(--soft-muted); font-size: 0.82rem; }
  .action-layout { display: grid; grid-template-columns: 12rem minmax(0, 46rem); gap: clamp(2rem, 7vw, 7rem); align-items: start; padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 10vw, 9rem); }
  .action-index { position: sticky; top: 1.5rem; padding-top: 0.35rem; }
  .action-index-title { margin: 0 0 1rem; color: var(--brand-dark); font-size: 0.78rem; font-weight: 800; }
  .action-index nav { display: grid; gap: 0.7rem; }
  .action-index a { color: var(--soft-muted); font-size: 0.78rem; line-height: 1.35; text-decoration: none; }
  .action-index a:hover, .action-index a:focus-visible { color: var(--accent); }
  .action-content { min-width: 0; }
  .action-section { padding-block: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid var(--line); }
  .action-section:first-child { padding-top: 0; border-top: 0; }
  .action-section h2, .action-related h2 { max-width: 20ch; font-size: clamp(2.1rem, 4.5vw, 4rem); }
  .action-section > p:not(.eyebrow), .action-related > p:not(.eyebrow) { max-width: 42rem; margin: 1.4rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .action-section > p + p:not(.eyebrow) { margin-top: 1rem; }
  .action-steps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .action-step { padding: 1.5rem; background: var(--surface); }
  .action-step-number { margin: 0 0 1.3rem; color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1.1rem; }
  .action-step h3, .action-card h3, .action-request h3 { margin: 0; color: var(--brand-dark); font-size: 1.15rem; letter-spacing: -0.03em; }
  .action-step p:last-child, .action-card p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .action-list { display: grid; gap: 0.9rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .action-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.9rem; align-items: start; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .action-list li > span { color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; }
  .action-list p { margin: 0; color: var(--ink); font-size: 0.98rem; line-height: 1.6; }
  .action-note, .action-warning, .action-request { margin-top: 2rem; padding: 1.5rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }
  .action-note strong, .action-warning strong { color: var(--brand-dark); }
  .action-note p, .action-warning p { max-width: 38rem; margin: 0.6rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .action-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .action-card { padding: 1.5rem; background: var(--surface); }
  .action-cards-plain { background: transparent; border: 0; gap: 1rem; overflow: visible; }
  .action-cards-plain .action-card { border: 1px solid var(--line); border-radius: 0.9rem; }
  .action-limit { padding: clamp(2rem, 5vw, 3.5rem); border: 0; border-radius: 1rem; background: var(--accent-soft); }
  .action-limit + .action-section { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .action-request { border-left-color: var(--brand); background: var(--surface-alt); }
  .action-request h3 { font-size: 1.35rem; }
  .action-list-compact { margin-top: 1.2rem; }
  .action-list-compact li { grid-template-columns: 1rem 1fr; border-bottom-color: var(--line); }
  .action-list-compact li > span { color: var(--brand); font-family: inherit; font-weight: 800; }
  .action-faq { margin-top: 2rem; border-top: 1px solid var(--line); }
  .action-faq details { border-bottom: 1px solid var(--line); }
  .action-faq summary { padding: 1.25rem 2rem 1.25rem 0; color: var(--brand-dark); cursor: pointer; font-weight: 750; list-style-position: outside; }
  .action-faq p { max-width: 40rem; margin: -0.4rem 0 1.25rem; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }
  .action-related { margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 1rem; background: var(--surface-alt); }
  .action-related-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: 1.6rem; }
  .action-related-links a { color: var(--brand); font-size: 0.9rem; font-weight: 750; text-underline-offset: 0.2em; }
  .action-related-links a span { color: var(--accent); text-decoration: none; }

  @media (max-width: 820px) {
    .action-layout { grid-template-columns: 1fr; }
    .action-index { position: static; padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .action-index nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .action-index a { font-size: 0.82rem; }
  }

  @media (max-width: 620px) {
    .action-hero h1 { font-size: clamp(2.8rem, 14vw, 4.8rem); }
    .action-steps, .action-cards { grid-template-columns: 1fr; }
    .action-related-links { display: grid; }
  }
</style>
