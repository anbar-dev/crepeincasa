---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const questions = [
  {
    number: '01',
    title: 'Il problema è cambiato?',
    text: 'Riferisci se la linea ti sembra diversa, se è ricomparsa dopo un ripristino o se sono comparsi altri segni. Non servono misure improvvisate.',
  },
  {
    number: '02',
    title: 'È successo qualcosa intorno?',
    text: 'Lavori recenti, infiltrazioni, umidità, variazioni nell’ambiente o problemi d’uso possono aiutare a ricostruire la storia. Non dimostrano da soli una causa.',
  },
  {
    number: '03',
    title: 'Devi decidere come intervenire?',
    text: 'Se devi scegliere un ripristino o un lavoro, una descrizione online non basta: serve una valutazione sul posto da parte di un professionista qualificato.',
  },
];

const urgentObservations = [
  'materiale che sembra staccarsi o cadere;',
  'acqua, gocciolamenti o una condizione che rende rischioso avvicinarsi;',
  'un cambiamento che percepisci come rapido o associato ad altri fenomeni;',
  'una zona che non puoi documentare senza avvicinarti, salire o fare prove rischiose.',
];

const ordinaryReasons = [
    'il problema persiste e vuoi capire come intervenire;',
    'non sai se il segno riguarda una finitura, un rivestimento o un altro elemento;',
    'è comparso dopo lavori, modifiche, infiltrazioni o un periodo di inutilizzo;',
    'devi valutare un ripristino e vuoi evitare di scegliere al buio;',
    'hai fotografie o documenti che possono aiutare a raccontare la storia.',
];

const requestChecklist = [
    'dove si trova il segno e con quali elementi dell’ambiente è in rapporto;',
    'che cosa si vede sulla superficie, senza attribuire una causa;',
    'da quando lo noti e che cosa è cambiato;',
    'quali lavori, acqua, umidità o modifiche ricordi;',
    'quali fotografie o documenti puoi mettere a disposizione;',
    'che cosa vuoi decidere, senza indicare già una tecnica.',
];

const faq = [
  {
    question: 'Devo aspettare che una crepa aumenti prima di chiedere una verifica?',
    answer: 'No. Puoi chiedere un confronto quando hai bisogno di capire il problema o decidere come procedere. Le informazioni disponibili servono a spiegare la situazione, non a formulare una diagnosi.',
  },
  {
    question: 'La sola presenza di una crepa richiede sempre un tecnico?',
    answer: 'No. La sola presenza o forma visibile non stabilisce la causa. La decisione dipende dal contesto e da ciò che devi capire o decidere.',
  },
  {
    question: 'La larghezza indica quando chiamare un professionista?',
    answer: 'No. Una singola dimensione, soprattutto se rilevata senza strumenti e contesto, non è una regola sufficiente. Servono posizione, materiali, storia e sopralluogo.',
  },
  {
    question: 'Posso chiedere un preventivo senza sapere la causa?',
    answer: 'Puoi chiedere informazioni, ma è prudente non indicare una tecnica come già necessaria. Prima di valutare opere, il caso concreto va esaminato.',
  },
  {
    question: 'Cosa faccio se la situazione sembra urgente?',
    answer: 'Evita la zona se necessario e chiedi tempestivamente supporto a un professionista qualificato o alle autorità competenti. Questo sito non è un servizio di emergenza e non può valutare la sicurezza dell’edificio.',
  },
];
---

<BaseLayout
  title="Quando chiamare un tecnico per una crepa nel muro"
  description="Quando chiamare un tecnico per una crepa nel muro: i casi in cui conviene chiedere un sopralluogo e cosa spiegare, senza diagnosi a distanza."
  canonical="https://crepeincasa.it/crepe-nei-muri/quando-chiedere-verifica/"
>
  <article class="verification-page">
    <header class="verification-hero">
      <div class="container verification-hero-inner">
        <p class="eyebrow">Capire quando intervenire</p>
        <h1 id="page-title">Quando chiamare un tecnico per una crepa nel muro</h1>
        <p class="verification-lead">
          Non esiste una regola basata soltanto sulla forma. La domanda utile è più semplice: il
          problema va capito meglio prima di riparare o decidere come intervenire?
        </p>
        <p class="verification-meta">Tempo di lettura: circa 7 minuti · Nessuna diagnosi a distanza</p>
      </div>
    </header>

    <div class="container verification-layout">
      <aside class="verification-index" aria-label="In questa guida">
        <p class="verification-index-title">In questa guida</p>
        <nav>
          <a href="#risposta">La risposta breve</a>
          <a href="#domande">Tre domande utili</a>
          <a href="#attenzione">Prima la sicurezza</a>
          <a href="#verifica">Quando chiedere un sopralluogo</a>
          <a href="#richiesta">Che cosa raccontare</a>
          <a href="#faq">Domande frequenti</a>
        </nav>
      </aside>

      <div class="verification-content">
        <section class="verification-section verification-intro" id="risposta" aria-labelledby="answer-title">
          <p class="eyebrow">La risposta breve</p>
          <h2 id="answer-title">Un sopralluogo serve a capire il caso concreto</h2>
          <p>
            Una fotografia o una descrizione non mostrano tutto ciò che riguarda un immobile. Se il
            problema persiste, cambia, compare insieme ad altri elementi o ti costringe a decidere,
            chiedere una valutazione sul posto è il modo corretto per andare oltre le ipotesi.
          </p>
          <p>
            La forma della crepa non spiega da sola la causa. Il tecnico deve poter valutare materiali,
            posizione, storia dell’edificio e condizioni reali direttamente sul posto.
          </p>
        </section>

        <section class="verification-section" id="domande" aria-labelledby="questions-title">
          <p class="eyebrow">Un criterio pratico</p>
          <h2 id="questions-title">Parti da tre domande, non da una diagnosi</h2>
          <div class="verification-questions">
            {questions.map((question) => (
              <article class="verification-question">
                <p class="verification-number">{question.number}</p>
                <h3>{question.title}</h3>
                <p>{question.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="verification-section verification-alert" id="attenzione" aria-labelledby="attention-title">
          <p class="eyebrow">Prima la sicurezza</p>
          <h2 id="attention-title">Quando fermarti e chiedere aiuto</h2>
          <p>
            Se per capire meglio devi avvicinarti a materiale instabile, salire su una scala non sicura
            o fare una prova sulla superficie, fermati. Non vale la pena rischiare per ottenere una fotografia o una misura in più.
          </p>
          <ul class="verification-list verification-list-plain">
            {urgentObservations.map((item) => <li><span aria-hidden="true">—</span><p>{item}</p></li>)}
          </ul>
          <p>
            In presenza di condizioni che potrebbero richiedere attenzione urgente, evita la zona se
            necessario e rivolgiti tempestivamente a un professionista qualificato o alle autorità
            competenti. Questo sito non può stabilire se un edificio sia sicuro o pericoloso.
          </p>
        </section>

        <section class="verification-section" id="verifica" aria-labelledby="ordinary-title">
          <p class="eyebrow">Una verifica ordinaria</p>
          <h2 id="ordinary-title">Quando chiedere un sopralluogo</h2>
          <p>
            Non devi arrivare con una spiegazione completa. Chiedi un sopralluogo quando vuoi capire
            meglio il problema o devi decidere come procedere con manutenzione, ripristini o lavori.
          </p>
          <ul class="verification-list">
            {ordinaryReasons.map((reason, index) => (
              <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{reason}</p></li>
            ))}
          </ul>
          <div class="verification-note">
            <strong>Il tempo aiuta a ricostruire la storia</strong>
            <p>
              Una crepa stabile, una che sembra cambiata e una comparsa dopo un lavoro richiedono domande
              diverse. Nessuna descrizione, da sola, stabilisce causa, sicurezza o intervento necessario.
            </p>
          </div>
        </section>

        <section class="verification-section" aria-labelledby="limits-title">
          <p class="eyebrow">Cosa non usare come regola</p>
          <h2 id="limits-title">La forma, l’età della casa e una singola foto non bastano</h2>
          <div class="verification-cards">
            <article class="verification-card">
              <h3>La direzione</h3>
              <p>Diagonale, verticale o orizzontale sono descrizioni dell’andamento visibile. Non indicano automaticamente la causa.</p>
            </article>
            <article class="verification-card">
              <h3>Una misura isolata</h3>
              <p>Una larghezza rilevata senza contesto e senza strumenti appropriati non è una soglia universale per decidere cosa fare.</p>
            </article>
            <article class="verification-card">
              <h3>L’età dell’edificio</h3>
              <p>Una casa nuova o vecchia può avere storie, materiali e modifiche molto diverse. L’età non sostituisce il sopralluogo.</p>
            </article>
            <article class="verification-card">
              <h3>La fotografia</h3>
              <p>Può documentare il segno, ma non mostra sempre strati, collegamenti, ambienti confinanti o storia dell’immobile.</p>
            </article>
          </div>
        </section>

        <section class="verification-section" id="richiesta" aria-labelledby="request-title">
          <p class="eyebrow">Per spiegare il problema</p>
          <h2 id="request-title">Che cosa raccontare nella richiesta</h2>
          <p>
            Una richiesta utile deve far capire che cosa è successo e quale risposta stai cercando.
            Non serve anticipare la conclusione.
          </p>
          <div class="verification-request">
            <ul class="verification-list verification-list-compact">
              {requestChecklist.map((item) => <li><span aria-hidden="true">✓</span><p>{item}</p></li>)}
            </ul>
          </div>
          <p>
            Puoi usare il nostro modulo per raccontare il problema e chiedere un confronto. Il modulo
            non formula una diagnosi e non sostituisce un sopralluogo.
          </p>
        </section>

        <section class="verification-section" id="faq" aria-labelledby="faq-title">
          <p class="eyebrow">Domande frequenti</p>
          <h2 id="faq-title">Quando chiedere una verifica per una crepa</h2>
          <div class="verification-faq">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="verification-related" aria-labelledby="related-title">
          <p class="eyebrow">Continua da qui</p>
          <h2 id="related-title">Capisci il problema, poi chiedi il confronto</h2>
          <p>
            La guida pratica spiega cosa fare appena noti una crepa. Se hai già deciso di chiedere un
            confronto, puoi passare direttamente al modulo.
          </p>
          <div class="verification-links">
            <a href="/crepe-nei-muri/cosa-fare/">Leggi cosa fare dopo aver notato una crepa <span aria-hidden="true">→</span></a>
            <a href="/crepe-nei-muri/casa-nuova-dopo-lavori/">Casa nuova o dopo lavori <span aria-hidden="true">→</span></a>
            <a href="/crepe-nei-muri/">Vai alla guida generale <span aria-hidden="true">→</span></a>
            <a href="/richiedi-valutazione/">Chiedi una valutazione <span aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .verification-page { background: var(--paper); }
  .verification-hero { border-bottom: 1px solid var(--line); background: var(--surface); }
  .verification-hero-inner { padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5.5rem); }
  .verification-hero h1 { max-width: 14ch; font-size: clamp(3rem, 7vw, 6rem); }
  .verification-lead { max-width: 44rem; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1.12rem, 2vw, 1.4rem); line-height: 1.65; }
  .verification-meta { margin: 1.5rem 0 0; color: var(--soft-muted); font-size: 0.82rem; }
  .verification-layout { display: grid; grid-template-columns: 12rem minmax(0, 46rem); gap: clamp(2rem, 7vw, 7rem); align-items: start; padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 10vw, 9rem); }
  .verification-index { position: sticky; top: 1.5rem; padding-top: 0.35rem; }
  .verification-index-title { margin: 0 0 1rem; color: var(--brand-dark); font-size: 0.78rem; font-weight: 800; }
  .verification-index nav { display: grid; gap: 0.7rem; }
  .verification-index a { color: var(--soft-muted); font-size: 0.78rem; line-height: 1.35; text-decoration: none; }
  .verification-index a:hover, .verification-index a:focus-visible { color: var(--accent); }
  .verification-content { min-width: 0; }
  .verification-section { padding-block: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid var(--line); }
  .verification-section:first-child { padding-top: 0; border-top: 0; }
  .verification-section h2, .verification-related h2 { max-width: 20ch; font-size: clamp(2.1rem, 4.5vw, 4rem); }
  .verification-section > p:not(.eyebrow), .verification-related > p:not(.eyebrow) { max-width: 42rem; margin: 1.4rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .verification-section > p + p:not(.eyebrow) { margin-top: 1rem; }
  .verification-questions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .verification-question { padding: 1.5rem; background: var(--surface); }
  .verification-number { margin: 0 0 1.3rem; color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1.1rem; }
  .verification-question h3, .verification-card h3 { margin: 0; color: var(--brand-dark); font-size: 1.15rem; letter-spacing: -0.03em; }
  .verification-question p:last-child, .verification-card p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .verification-alert { padding: clamp(2rem, 5vw, 3.5rem); border: 0; border-radius: 1rem; background: var(--accent-soft); }
  .verification-alert + .verification-section { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .verification-list { display: grid; gap: 0.9rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .verification-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.9rem; align-items: start; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .verification-list li > span { color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; }
  .verification-list p { margin: 0; color: var(--ink); font-size: 0.98rem; line-height: 1.6; }
  .verification-list-plain li { grid-template-columns: 1rem 1fr; }
  .verification-note, .verification-request { margin-top: 2rem; padding: 1.5rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }
  .verification-note strong { color: var(--brand-dark); }
  .verification-note p { max-width: 38rem; margin: 0.6rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .verification-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2.5rem; }
  .verification-card { padding: 1.5rem; border: 1px solid var(--line); border-radius: 0.9rem; background: var(--surface); }
  .verification-request { border-left-color: var(--brand); background: var(--surface-alt); }
  .verification-list-compact { margin-top: 0; }
  .verification-list-compact li { grid-template-columns: 1rem 1fr; }
  .verification-list-compact li > span { color: var(--brand); font-family: inherit; font-weight: 800; }
  .verification-faq { margin-top: 2rem; border-top: 1px solid var(--line); }
  .verification-faq details { border-bottom: 1px solid var(--line); }
  .verification-faq summary { padding: 1.25rem 2rem 1.25rem 0; color: var(--brand-dark); cursor: pointer; font-weight: 750; list-style-position: outside; }
  .verification-faq p { max-width: 40rem; margin: -0.4rem 0 1.25rem; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }
  .verification-related { margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 1rem; background: var(--surface-alt); }
  .verification-links { display: grid; gap: 0.8rem; margin-top: 1.6rem; }
  .verification-links a { color: var(--brand); font-size: 0.9rem; font-weight: 750; text-underline-offset: 0.2em; }
  .verification-links a span { color: var(--accent); text-decoration: none; }

  @media (max-width: 820px) {
    .verification-layout { grid-template-columns: 1fr; }
    .verification-index { position: static; padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .verification-index nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .verification-index a { font-size: 0.82rem; }
    .verification-questions { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .verification-hero h1 { font-size: clamp(2.8rem, 14vw, 4.8rem); }
    .verification-cards { grid-template-columns: 1fr; }
  }
</style>
