---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import NextStep from '../../../components/NextStep.astro';

const informationBlocks = [
  {
    number: '01',
    title: 'Dove si trova',
    text: 'Indica ambiente, parete, soffitto o pavimento e il rapporto con angoli, porte, finestre o altri riferimenti visibili.',
  },
  {
    number: '02',
    title: 'Da quando la noti',
    text: 'Scrivi una data o un periodo approssimativo. Se non lo ricordi, dillo: una supposizione non aiuta a capire il problema.',
  },
  {
    number: '03',
    title: 'Che cosa è cambiato',
    text: 'Spiega che cosa ti sembra diverso rispetto a prima: posizione, aspetto, finitura o altri elementi nello stesso periodo.',
  },
  {
    number: '04',
    title: 'Che cosa è successo intorno',
    text: 'Riferisci lavori, infiltrazioni, umidità, cambi d’uso o altri eventi collegati, senza presentarli come spiegazione già acquisita.',
  },
];

const checklist = [
    'indirizzo o zona dell’immobile, limitandoti ai dati necessari al primo contatto;',
    'stanza, superficie e posizione del segno rispetto agli elementi dell’ambiente;',
    'data o periodo in cui l’hai notato e fotografie con data, se le hai;',
    'che cosa si vede: andamento, finitura, macchie, distacchi o altri cambiamenti;',
    'lavori recenti, infiltrazioni, modifiche o periodi di inutilizzo che ricordi;',
    'la domanda a cui vuoi una risposta, senza indicare in anticipo una tecnica;',
];

const attachments = [
  {
    title: 'Fotografie originali',
    text: 'Conserva una vista d’insieme e un dettaglio. Mantieni le immagini originali e indica la data dello scatto, se la conosci.',
  },
  {
    title: 'Una storia breve',
    text: 'Date, lavori, cambiamenti e ciò che non sai possono essere più utili di un racconto lungo e senza ordine.',
  },
  {
    title: 'Documenti che hai già',
    text: 'Se pertinenti, porta relazioni, fotografie di cantiere, fatture o comunicazioni che già possiedi. Non devi interpretarli da solo.',
  },
  {
    title: 'La domanda principale',
    text: 'Chiarisci che cosa vuoi capire: quali verifiche servono, se puoi riparare o se prima occorre approfondire.',
  },
];

const faq = [
  {
    question: 'Devo conoscere già la causa prima di contattare un tecnico?',
    answer: 'No. Puoi descrivere le osservazioni disponibili e spiegare quale confronto ti serve. La causa e le eventuali verifiche appropriate richiedono la valutazione del caso concreto.',
  },
  {
    question: 'Quali fotografie devo inviare?',
    answer: 'Parti da immagini che mostrino contesto e dettaglio, preferibilmente con data e punto di ripresa riconoscibili. Invia solo ciò che è pertinente e verifica che non contenga dati personali non necessari.',
  },
  {
    question: 'È utile indicare la larghezza della crepa?',
    answer: 'Puoi riportare una misura soltanto se è stata rilevata con modalità appropriate e se la presenti come dato osservato. Una misura isolata non è una regola sufficiente per stabilire causa, attenzione o intervento.',
  },
  {
    question: 'Cosa scrivo se non ricordo quando è comparsa?',
    answer: 'Scrivi che la data non è nota e indica il primo momento in cui l’hai notata. Anche distinguere ricordi certi, ipotesi e informazioni mancanti aiuta il tecnico a inquadrare il caso.',
  },
  {
    question: 'Posso chiedere direttamente un preventivo?',
    answer: 'Puoi spiegare che stai valutando un intervento, ma è prudente non presentare una tecnica come già necessaria. Prima occorre capire quali valutazioni siano appropriate per l’immobile reale.',
  },
];
---

<BaseLayout
  title="Crepa nel muro: che cosa dire al tecnico"
  description="Crepa nel muro: che cosa raccontare al tecnico, quali fotografie e documenti possono servire e come arrivare al confronto senza diagnosi online."
  canonical="https://crepeincasa.it/crepe-nei-muri/informazioni-per-tecnico/"
>
  <article class="brief-page">
    <header class="brief-hero">
      <div class="container brief-hero-inner">
        <p class="eyebrow">Parlare con un tecnico</p>
        <h1>Crepa nel muro: che cosa dire al tecnico</h1>
        <p class="brief-lead">
          Una richiesta chiara parte dal problema: luogo, date, fotografie, contesto e domanda principale.
          Non devi arrivare con una diagnosi già formulata.
        </p>
        <p class="brief-meta">Tempo di lettura: circa 7 minuti · Nessuna diagnosi a distanza</p>
      </div>
    </header>

    <div class="container brief-layout">
      <aside class="brief-index" aria-label="In questa guida">
        <p class="brief-index-title">In questa guida</p>
        <nav>
          <a href="#risposta">La risposta breve</a>
          <a href="#blocchi">I quattro elementi</a>
          <a href="#checklist">Che cosa serve sapere</a>
          <a href="#allegati">Foto e documenti</a>
          <a href="#domande">La domanda da chiarire</a>
          <a href="#faq">Domande frequenti</a>
        </nav>
      </aside>

      <div class="brief-content">
        <section class="brief-section brief-intro" id="risposta" aria-labelledby="answer-title">
          <p class="eyebrow">La risposta breve</p>
          <h2 id="answer-title">Spiega il problema con chiarezza</h2>
          <p>
            Chi riceve la richiesta ha bisogno di capire dove si trova il segno, da quando lo noti,
            che cosa è cambiato e quali eventi possono completare la storia. Sono informazioni utili,
            ma non sostituiscono l’esame dell’immobile.
          </p>
          <div class="brief-note">
            <strong>Scrivi i fatti prima delle interpretazioni</strong>
            <p>“Ho notato una linea vicino alla finestra il 10 agosto” descrive un fatto. “La parete sta cedendo” è una conclusione che una richiesta online non può dimostrare.</p>
          </div>
        </section>

        <NextStep
          title="Non devi avere già tutte le risposte"
          text="Non servono ogni documento né termini tecnici. Racconta il problema, ciò che ricordi e ciò che vuoi capire: il confronto sul posto farà il resto."
          primary={{ href: '/richiedi-valutazione/', label: 'Chiedi una valutazione' }}
          secondaryLinks={[
            { href: '/crepe-nei-muri/come-fotografare-monitorare-crepa/', label: 'Come fotografare e monitorare una crepa' },
            { href: '/crepe-nei-muri/quando-chiedere-verifica/', label: 'Quando chiedere una verifica' },
          ]}
        />

        <section class="brief-section" id="blocchi" aria-labelledby="blocks-title">
          <p class="eyebrow">Per spiegare il problema</p>
          <h2 id="blocks-title">Bastano quattro elementi</h2>
          <p>
            Se un dato non è noto, dillo apertamente. È più utile di una ricostruzione fatta per supposizioni.
          </p>
          <div class="brief-blocks">
            {informationBlocks.map((item) => (
              <article class="brief-block">
                <p class="brief-number">{item.number}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="brief-section" id="checklist" aria-labelledby="checklist-title">
          <p class="eyebrow">Prima del contatto</p>
          <h2 id="checklist-title">Che cosa serve sapere per iniziare</h2>
          <p>
            Non devi completare una scheda prima di chiedere un confronto. Usa questi punti solo per
            capire che cosa hai già e che cosa invece manca.
          </p>
          <ul class="brief-list">
            {checklist.map((item, index) => (
              <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
            ))}
          </ul>
        </section>

        <section class="brief-section" id="allegati" aria-labelledby="attachments-title">
          <p class="eyebrow">Materiale utile</p>
          <h2 id="attachments-title">Quali foto e documenti possono servire</h2>
          <p>
            Invia solo materiale pertinente al primo confronto. Foto e documenti accompagnano la descrizione,
            ma non permettono da soli di stabilire la causa.
          </p>
          <div class="brief-cards">
            {attachments.map((item) => (
              <article class="brief-card">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
          <div class="brief-limit">
            <strong>Proteggi i dati non necessari</strong>
            <p>Prima di condividere immagini o documenti, controlla che non mostrino dati personali, indirizzi, volti o informazioni di terzi che non servono alla richiesta.</p>
          </div>
        </section>

        <section class="brief-section" id="domande" aria-labelledby="questions-title">
          <p class="eyebrow">Per parlare con chiarezza</p>
          <h2 id="questions-title">Quale domanda vuoi risolvere?</h2>
          <p>
            Arriva al confronto con una domanda concreta: ti aiuta a ottenere una risposta utile senza
            trasformare la richiesta in una diagnosi.
          </p>
          <div class="brief-question-list">
            <p>Quali elementi dell’immobile dovrà controllare direttamente il tecnico?</p>
            <p>Quali informazioni o documenti servono per inquadrare meglio il contesto?</p>
            <p>È opportuno monitorare qualcosa e con quale modalità indicata dal professionista?</p>
            <p>Quali alternative vanno considerate prima di parlare di lavori?</p>
          </div>
        </section>

        <section class="brief-section brief-alert" aria-labelledby="alert-title">
          <p class="eyebrow">Prima di documentare</p>
          <h2 id="alert-title">Non fare prove rischiose per completare la richiesta</h2>
          <p>
            Non salire su scale instabili, non rimuovere materiale e non avvicinarti a zone con distacchi
            o condizioni che rendono rischioso avvicinarsi. Se la situazione potrebbe richiedere
            attenzione urgente, allontanati se necessario e rivolgiti tempestivamente a un professionista
            qualificato o alle autorità competenti.
          </p>
        </section>

        <section class="brief-section" id="faq" aria-labelledby="faq-title">
          <p class="eyebrow">Domande frequenti</p>
          <h2 id="faq-title">Che cosa dire al tecnico</h2>
          <div class="brief-faq">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="brief-related" aria-labelledby="related-title">
          <p class="eyebrow">Continua il percorso</p>
          <h2 id="related-title">Dalla descrizione al confronto</h2>
          <p>
            Puoi approfondire come usare le fotografie oppure passare direttamente al modulo per chiedere
            una valutazione.
          </p>
          <div class="brief-links">
            <a href="/crepe-nei-muri/come-fotografare-monitorare-crepa/">Come fotografare e monitorare una crepa <span aria-hidden="true">→</span></a>
            <a href="/crepe-nei-muri/quando-chiedere-verifica/">Quando chiedere una verifica <span aria-hidden="true">→</span></a>
            <a href="/crepe-nei-muri/cosa-fare/">Cosa fare dopo aver notato una crepa <span aria-hidden="true">→</span></a>
            <a href="/richiedi-valutazione/">Chiedi una valutazione <span aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .brief-page { background: var(--paper); }
  .brief-hero { border-bottom: 1px solid var(--line); background: var(--surface); }
  .brief-hero-inner { padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5.5rem); }
  .brief-hero h1 { max-width: 15ch; font-size: clamp(3rem, 7vw, 6rem); }
  .brief-lead { max-width: 44rem; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1.12rem, 2vw, 1.4rem); line-height: 1.65; }
  .brief-meta { margin: 1.5rem 0 0; color: var(--soft-muted); font-size: 0.82rem; }
  .brief-layout { display: grid; grid-template-columns: 12rem minmax(0, 46rem); gap: clamp(2rem, 7vw, 7rem); align-items: start; padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 10vw, 9rem); }
  .brief-index { position: sticky; top: 1.5rem; padding-top: 0.35rem; }
  .brief-index-title { margin: 0 0 1rem; color: var(--brand-dark); font-size: 0.78rem; font-weight: 800; }
  .brief-index nav { display: grid; gap: 0.7rem; }
  .brief-index a { color: var(--soft-muted); font-size: 0.78rem; line-height: 1.35; text-decoration: none; }
  .brief-index a:hover, .brief-index a:focus-visible { color: var(--accent); }
  .brief-content { min-width: 0; }
  .brief-section { padding-block: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid var(--line); }
  .brief-intro { padding-top: 0; border-top: 0; }
  .brief-section h2, .brief-related h2 { max-width: 20ch; font-size: clamp(2.1rem, 4.5vw, 4rem); }
  .brief-section > p:not(.eyebrow), .brief-related > p:not(.eyebrow) { max-width: 42rem; margin: 1.4rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .brief-note, .brief-limit { margin-top: 2rem; padding: 1.5rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }
  .brief-note strong, .brief-limit strong { color: var(--brand-dark); }
  .brief-note p, .brief-limit p { max-width: 38rem; margin: 0.6rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .brief-blocks { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .brief-block { padding: 1.5rem; background: var(--surface); }
  .brief-number { margin: 0 0 1.3rem; color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1.1rem; }
  .brief-block h3, .brief-card h3 { margin: 0; color: var(--brand-dark); font-size: 1.15rem; letter-spacing: -0.03em; }
  .brief-block p:last-child, .brief-card p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .brief-list { display: grid; gap: 0.9rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .brief-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.9rem; align-items: start; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .brief-list li > span { color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; }
  .brief-list p { margin: 0; color: var(--ink); font-size: 0.98rem; line-height: 1.6; }
  .brief-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 2.5rem; }
  .brief-card { padding: 1.5rem; border: 1px solid var(--line); border-radius: 0.9rem; background: var(--surface); }
  .brief-limit { border-left-color: var(--brand); background: var(--surface-alt); }
  .brief-question-list { display: grid; gap: 0.8rem; margin-top: 2rem; }
  .brief-question-list p { margin: 0; padding: 1.1rem 1.25rem; border: 1px solid var(--line); border-radius: 0.75rem; background: var(--surface); color: var(--brand-dark); font-size: 0.98rem; line-height: 1.5; }
  .brief-alert { padding: clamp(2rem, 5vw, 3.5rem); border: 0; border-radius: 1rem; background: var(--accent-soft); }
  .brief-faq { margin-top: 2rem; border-top: 1px solid var(--line); }
  .brief-faq details { border-bottom: 1px solid var(--line); }
  .brief-faq summary { padding: 1.25rem 2rem 1.25rem 0; color: var(--brand-dark); cursor: pointer; font-weight: 750; list-style-position: outside; }
  .brief-faq p { max-width: 40rem; margin: -0.4rem 0 1.25rem; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }
  .brief-related { margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 1rem; background: var(--surface-alt); }
  .brief-links { display: grid; gap: 0.8rem; margin-top: 1.6rem; }
  .brief-links a { color: var(--brand); font-size: 0.9rem; font-weight: 750; text-underline-offset: 0.2em; }
  .brief-links a span { color: var(--accent); text-decoration: none; }

  @media (max-width: 820px) {
    .brief-layout { grid-template-columns: 1fr; }
    .brief-index { position: static; padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .brief-index nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .brief-index a { font-size: 0.82rem; }
  }

  @media (max-width: 620px) {
    .brief-hero h1 { font-size: clamp(2.8rem, 14vw, 4.8rem); }
    .brief-blocks, .brief-cards { grid-template-columns: 1fr; }
  }
</style>
