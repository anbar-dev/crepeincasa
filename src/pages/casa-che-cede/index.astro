---
import BaseLayout from '../../layouts/BaseLayout.astro';

const contexts = [
  {
    number: '01',
    title: 'Segni nell’abitazione',
    text: 'Fessure, distacchi, pavimenti percepiti come irregolari o cambiamenti nelle finiture si possono descrivere con stanza, posizione e data. Nessuno di questi elementi identifica da solo una causa.',
  },
  {
    number: '02',
    title: 'Cambiamenti nell’uso',
    text: 'Porte o finestre che funzionano diversamente, soglie cambiate o arredi che sembrano fuori piano sono osservazioni da annotare, senza usarle come prova di un movimento dell’edificio.',
  },
  {
    number: '03',
    title: 'Storia e ambiente',
    text: 'Età, ampliamenti, lavori, acqua, terreno, scavi o eventi recenti possono completare il contesto. La loro presenza non dimostra un rapporto di causa con ciò che hai notato.',
  },
];

const checklist = [
  'quali ambienti o parti della casa sono interessati e quali invece non mostrano il cambiamento;',
  'posizione, orientamento e aspetto di ogni fessura o segno, usando parole descrittive e non etichette tecniche;',
  'quando hai notato per la prima volta il cambiamento e se esistono fotografie o documenti datati per confrontarlo;',
  'che cosa è cambiato nell’uso di porte, finestre, soglie o pavimenti, distinguendo la percezione da una misura tecnica;',
  'lavori, ampliamenti, ristrutturazioni, perdite, infiltrazioni, scavi o modifiche del terreno ricordati nello stesso periodo;',
  'quali zone non hai potuto osservare e quali informazioni non conosci, senza cercare di completare il quadro con ipotesi.',
];

const comparisonSteps = [
  {
    title: 'Parti da una pianta',
    text: 'Segna gli ambienti e la posizione delle osservazioni su uno schizzo semplice. Non ricostruire a intuito la struttura o la profondità delle fondazioni.',
  },
  {
    title: 'Ordina le date',
    text: 'Metti in sequenza fotografie, lavori, piogge, perdite e altri cambiamenti ricordati. Una sequenza aiuta a raccontare, ma non dimostra la causa.',
  },
  {
    title: 'Conserva il contesto',
    text: 'Per le foto includi, quando puoi, una vista dell’ambiente e un dettaglio. Conserva gli originali e non modificare le superfici per renderle più leggibili.',
  },
];

const questions = [
  {
    title: 'Quale problema va verificato?',
    text: 'Chiedi di distinguere i diversi segni osservati e di indicare quali informazioni siano pertinenti, senza partire dall’idea che l’intera casa abbia una sola causa.',
  },
  {
    title: 'Quali parti devono essere confrontate?',
    text: 'Domanda se sia utile esaminare ambienti, facciate, terreno, opere vicine, documenti dei lavori o altri elementi del contesto reale.',
  },
  {
    title: 'Quali verifiche sono appropriate?',
    text: 'Chiedi quali rilievi o approfondimenti possano rispondere alla domanda concreta e quali limiti abbiano foto, descrizioni e controlli domestici.',
  },
];

const attentionPoints = [
  'distacchi o cadute di materiale, ostacoli o elementi che sembrano instabili;',
  'acqua, gas, cavi esposti o una condizione che rende rischioso avvicinarsi;',
  'un cambiamento percepito come rapido o associato ad altri fenomeni nell’edificio o nel terreno;',
  'una zona che richiederebbe scavi, demolizioni, sollevamenti o prove con strumenti non disponibili.',
];

const faq = [
  {
    question: 'Come faccio a capire se una casa sta cedendo?',
    answer: 'Non è possibile confermarlo da una fotografia, da una crepa o da un questionario. Puoi raccogliere posizione, date, cambiamenti e contesto; il loro significato richiede una valutazione riferita all’immobile reale.',
  },
  {
    question: 'Una casa con crepe è una casa che cede?',
    answer: 'No. Le fessure possono avere contesti e cause diverse. Descriverle con precisione può aiutare un confronto qualificato, ma non dimostra l’esistenza di un cedimento.',
  },
  {
    question: 'Porte e finestre che si chiudono male sono una prova?',
    answer: 'Sono cambiamenti che puoi annotare con data e posizione, ma non costituiscono da soli una prova della causa. Vanno considerati insieme alla storia dell’immobile e agli altri elementi pertinenti.',
  },
  {
    question: 'Devo controllare il pavimento con una livella o rompere una parete?',
    answer: 'Non fare demolizioni, scavi o prove improvvisate per confermare un’ipotesi. Documenta ciò che puoi osservare senza alterare l’immobile e chiedi quali verifiche siano appropriate.',
  },
  {
    question: 'Devo chiedere subito un intervento?',
    answer: 'Prima occorre comprendere il contesto e stabilire quali verifiche servano. Una tecnica non può essere scelta sulla base di una descrizione o di una fotografia.',
  },
  {
    question: 'Cosa faccio se la situazione può richiedere attenzione urgente?',
    answer: 'Non avvicinarti se la zona non ti sembra sicura. Allontanati se necessario e rivolgiti tempestivamente a un professionista qualificato o alle autorità competenti. Questo sito non è un servizio di emergenza.',
  },
];
---

<BaseLayout
  title="Casa che cede: cosa osservare prima di una verifica"
  description="Casa che cede: come raccogliere osservazioni su ambienti, fessure, cambiamenti, storia e terreno senza confermare online un cedimento o indicare una tecnica."
  canonical="https://crepeincasa.it/casa-che-cede/"
>
  <article class="house-page">
    <header class="house-hero">
      <div class="container house-hero-inner">
        <p class="eyebrow">Guida a osservazioni e contesto</p>
        <h1>Casa che cede: cosa osservare prima di una verifica</h1>
        <p class="house-lead">
          “Casa che cede” è un modo per descrivere una preoccupazione, non una conclusione ricavabile da una foto o
          da un singolo segno. Puoi ordinare ciò che osservi nella casa e intorno ad essa per preparare un confronto qualificato.
        </p>
        <p class="house-meta">Lettura di circa 8 minuti · Nessuna diagnosi online</p>
      </div>
    </header>

    <div class="container house-layout">
      <aside class="house-index" aria-label="In questa guida">
        <p class="house-index-title">In questa guida</p>
        <nav>
          <a href="#risposta">La risposta breve</a>
          <a href="#contesto">Tre contesti da riferire</a>
          <a href="#checklist">Cosa raccogliere</a>
          <a href="#confronto">Come ordinare le osservazioni</a>
          <a href="#verifica">Come preparare la verifica</a>
          <a href="#attenzione">Quando fermarsi</a>
          <a href="#faq">Domande frequenti</a>
          <a href="#fonti">Fonti istituzionali</a>
        </nav>
      </aside>

      <div class="house-content">
        <section class="house-section house-intro" id="risposta" aria-labelledby="answer-title">
          <p class="eyebrow">La risposta breve</p>
          <h2 id="answer-title">Una preoccupazione generale va trasformata in osservazioni verificabili</h2>
          <p>
            Quando una persona dice che “la casa cede”, può riferirsi a una fessura, a un pavimento percepito come
            irregolare, a un cambiamento nelle aperture o a una variazione del terreno. Sono situazioni diverse, che
            non si possono riunire in una diagnosi a distanza.
          </p>
          <p>
            Una valutazione sul posto può considerare l’edificio nel suo insieme, la storia dei lavori, il terreno,
            l’acqua e la cronologia. Prima di quel confronto, il compito utile è descrivere i fatti senza anticipare
            la spiegazione.
          </p>
          <div class="house-note">
            <strong>Racconta che cosa è cambiato</strong>
            <p>“Da aprile noto una fessura vicino alla scala e la porta della stanza sfrega” riporta due osservazioni. “La casa sta cedendo” è un’interpretazione che richiede verifica.</p>
          </div>
        </section>

        <section class="house-section" id="contesto" aria-labelledby="context-title">
          <p class="eyebrow">Possibili elementi di contesto</p>
          <h2 id="context-title">Tre aree da descrivere senza attribuire la causa</h2>
          <p>
            Parti da ciò che puoi vedere o ricordare direttamente. Se un dato manca, indicalo: un’informazione
            incompleta è più utile di una spiegazione costruita a intuito.
          </p>
          <div class="house-contexts">
            {contexts.map((item) => (
              <article class="house-context">
                <p class="house-number">{item.number}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </section>

        <section class="house-section" id="checklist" aria-labelledby="checklist-title">
          <p class="eyebrow">Raccogliere informazioni</p>
          <h2 id="checklist-title">Checklist per descrivere la casa</h2>
          <p>
            Una richiesta ordinata aiuta a separare la sensazione generale dai singoli elementi osservati. Fotografa
            solo ciò che puoi raggiungere in sicurezza e conserva gli originali.
          </p>
          <ul class="house-list">
            {checklist.map((item, index) => (
              <li><span aria-hidden="true">{String(index + 1).padStart(2, '0')}</span><p>{item}</p></li>
            ))}
          </ul>
          <div class="house-limit">
            <strong>Non usare un’etichetta al posto del dato</strong>
            <p>“Il pavimento sembra inclinato verso la parete esterna” descrive una percezione e una direzione. Non dimostra che la casa o le fondazioni si stiano muovendo.</p>
          </div>
        </section>

        <section class="house-section" id="confronto" aria-labelledby="comparison-title">
          <p class="eyebrow">Cronologia prudente</p>
          <h2 id="comparison-title">Metti in ordine le osservazioni senza fare prove</h2>
          <div class="house-steps">
            {comparisonSteps.map((item, index) => (
              <article class="house-step">
                <p class="house-step-number">{String(index + 1).padStart(2, '0')}</p>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
          <p>
            Confrontare fotografie e date serve a documentare ciò che hai notato. Non sostituisce rilievi professionali
            e non consente di stabilire se esista un cedimento, quale elemento sia coinvolto o quale intervento possa servire.
          </p>
        </section>

        <section class="house-section" id="verifica" aria-labelledby="verification-title">
          <p class="eyebrow">Confronto qualificato</p>
          <h2 id="verification-title">Che cosa chiedere prima di valutare lavori</h2>
          <p>
            Una richiesta utile parte dalla domanda concreta e dal contesto che puoi documentare. Non serve scegliere
            in anticipo tra consolidamento, micropali, resine o altre tecniche.
          </p>
          <div class="house-questions">
            {questions.map((item) => (
              <article class="house-question">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
          <p>
            Un tecnico qualificato può indicare quali dati siano pertinenti al caso concreto e se siano necessari
            approfondimenti. Il riepilogo online trasmette le tue osservazioni e non sostituisce un sopralluogo.
          </p>
        </section>

        <section class="house-section house-alert" id="attenzione" aria-labelledby="attention-title">
          <p class="eyebrow">Prima la sicurezza</p>
          <h2 id="attention-title">Quando interrompere l’osservazione</h2>
          <p>
            Non rendere più rischiosa la raccolta delle informazioni. Evita di entrare in zone non accessibili,
            rimuovere elementi o fare prove sulla casa, sul pavimento o sul terreno.
          </p>
          <ul class="house-list house-list-plain">
            {attentionPoints.map((item) => <li><span aria-hidden="true">—</span><p>{item}</p></li>)}
          </ul>
          <p>
            In condizioni che potrebbero richiedere attenzione urgente, allontanati se necessario e rivolgiti
            tempestivamente a un professionista qualificato o alle autorità competenti. Per il contesto delle verifiche
            post-sisma, consulta la <a href="https://www.protezionecivile.gov.it/it/approfondimento/scheda-aedes/" target="_blank" rel="noreferrer">scheda AeDES</a>
            del Dipartimento della Protezione Civile. Questo sito non è un servizio di emergenza.
          </p>
        </section>

        <section class="house-section house-faq" id="faq" aria-labelledby="faq-title">
          <p class="eyebrow">Domande frequenti</p>
          <h2 id="faq-title">Casa che cede</h2>
          <div class="house-faq-list">
            {faq.map((item) => (
              <details>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>

        <section class="house-sources" id="fonti" aria-labelledby="sources-title">
          <p class="eyebrow">Per approfondire</p>
          <h2 id="sources-title">Fonti istituzionali sul contesto delle verifiche</h2>
          <p>
            Le fonti seguenti descrivono procedure e norme generali. Non sono strumenti per diagnosticare una casa a
            distanza e non sostituiscono una valutazione professionale riferita all’immobile.
          </p>
          <ul>
            <li><a href="https://www.protezionecivile.gov.it/it/approfondimento/scheda-aedes/" target="_blank" rel="noreferrer">Dipartimento della Protezione Civile — Scheda AeDES</a></li>
            <li><a href="https://www.gazzettaufficiale.it/atto/serie_generale/caricaArticoloDefault/originario?atto.codiceRedazionale=18A00716&amp;atto.dataPubblicazioneGazzetta=2018-02-20" target="_blank" rel="noreferrer">Gazzetta Ufficiale — Norme tecniche per le costruzioni</a></li>
            <li><a href="https://www.gazzettaufficiale.it/atto/serie_generale/caricaDettaglioAtto/originario?atto.codiceRedazionale=088A1293&amp;elenco30giorni=false" target="_blank" rel="noreferrer">Gazzetta Ufficiale — Indagini sui terreni e opere di fondazione</a></li>
          </ul>
        </section>

        <section class="house-related" aria-labelledby="related-title">
          <p class="eyebrow">Continua il percorso</p>
          <h2 id="related-title">Dal dubbio alla richiesta</h2>
          <p>
            Se stai raccogliendo informazioni su una fessurazione, sul terreno o su un possibile problema alle
            fondazioni, puoi confrontare le guide e preparare un riepilogo neutro.
          </p>
          <div class="house-links">
            <a href="/cedimento-fondazioni/">Cedimento delle fondazioni: cosa osservare <span aria-hidden="true">→</span></a>
            <a href="/cedimento-differenziale/">Cedimento differenziale: cosa osservare <span aria-hidden="true">→</span></a>
            <a href="/cedimento-terreno/">Cedimento del terreno: cosa osservare <span aria-hidden="true">→</span></a>
            <a href="/crepe-nei-muri/crepe-sul-pavimento/">Crepe sul pavimento: cosa osservare <span aria-hidden="true">→</span></a>
            <a href="/richiedi-valutazione/">Prepara una richiesta neutra <span aria-hidden="true">→</span></a>
          </div>
        </section>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .house-page { background: var(--paper); }
  .house-hero { border-bottom: 1px solid var(--line); background: var(--surface); }
  .house-hero-inner { padding-block: clamp(4rem, 9vw, 7rem) clamp(3.5rem, 7vw, 5.5rem); }
  .house-hero h1 { max-width: 14ch; font-size: clamp(3rem, 7vw, 6rem); }
  .house-lead { max-width: 44rem; margin: 2rem 0 0; color: var(--muted); font-size: clamp(1.12rem, 2vw, 1.4rem); line-height: 1.65; }
  .house-meta { margin: 1.5rem 0 0; color: var(--soft-muted); font-size: 0.82rem; }
  .house-layout { display: grid; grid-template-columns: 12rem minmax(0, 46rem); gap: clamp(2rem, 7vw, 7rem); align-items: start; padding-block: clamp(3rem, 7vw, 6rem) clamp(5rem, 10vw, 9rem); }
  .house-index { position: sticky; top: 1.5rem; padding-top: 0.35rem; }
  .house-index-title { margin: 0 0 1rem; color: var(--brand-dark); font-size: 0.78rem; font-weight: 800; }
  .house-index nav { display: grid; gap: 0.7rem; }
  .house-index a { color: var(--soft-muted); font-size: 0.78rem; line-height: 1.35; text-decoration: none; }
  .house-index a:hover, .house-index a:focus-visible { color: var(--accent); }
  .house-content { min-width: 0; }
  .house-section { padding-block: clamp(3rem, 6vw, 5.5rem); border-top: 1px solid var(--line); }
  .house-intro { padding-top: 0; border-top: 0; }
  .house-section h2, .house-sources h2, .house-related h2 { max-width: 20ch; font-size: clamp(2.1rem, 4.5vw, 4rem); }
  .house-section > p:not(.eyebrow), .house-sources > p:not(.eyebrow), .house-related > p:not(.eyebrow) { max-width: 42rem; margin: 1.4rem 0 0; color: var(--muted); font-size: 1rem; line-height: 1.75; }
  .house-section > p + p:not(.eyebrow) { margin-top: 1rem; }
  .house-section a, .house-sources a { color: var(--brand); text-underline-offset: 0.2em; }
  .house-note, .house-limit { margin-top: 2rem; padding: 1.5rem; border-left: 3px solid var(--accent); background: var(--accent-soft); }
  .house-note strong, .house-limit strong { color: var(--brand-dark); }
  .house-note p, .house-limit p { max-width: 38rem; margin: 0.6rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .house-contexts, .house-steps, .house-questions { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; margin-top: 2.5rem; overflow: hidden; border: 1px solid var(--line); border-radius: 1rem; background: var(--line); }
  .house-context, .house-step, .house-question { padding: 1.5rem; background: var(--surface); }
  .house-number, .house-step-number { margin: 0 0 1.3rem; color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1.1rem; }
  .house-context h3, .house-step h3, .house-question h3 { margin: 0; color: var(--brand-dark); font-size: 1.15rem; letter-spacing: -0.03em; }
  .house-context p:last-child, .house-step p:last-child, .house-question p { margin: 0.8rem 0 0; color: var(--muted); font-size: 0.92rem; line-height: 1.6; }
  .house-list { display: grid; gap: 0.9rem; margin: 2rem 0 0; padding: 0; list-style: none; }
  .house-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 0.9rem; align-items: start; padding-bottom: 0.9rem; border-bottom: 1px solid var(--line); }
  .house-list li > span { color: var(--accent); font-family: Georgia, 'Times New Roman', serif; font-size: 1rem; }
  .house-list p { margin: 0; color: var(--ink); font-size: 0.98rem; line-height: 1.6; }
  .house-list-plain li { grid-template-columns: 1rem 1fr; }
  .house-alert { padding: clamp(2rem, 5vw, 3.5rem); border: 0; border-radius: 1rem; background: var(--accent-soft); }
  .house-alert + .house-section { margin-top: clamp(1rem, 3vw, 2.5rem); }
  .house-faq-list { margin-top: 2rem; border-top: 1px solid var(--line); }
  .house-faq-list details { border-bottom: 1px solid var(--line); }
  .house-faq-list summary { padding: 1.25rem 2rem 1.25rem 0; color: var(--brand-dark); cursor: pointer; font-weight: 750; list-style-position: outside; }
  .house-faq-list p { max-width: 40rem; margin: -0.4rem 0 1.25rem; color: var(--muted); font-size: 0.95rem; line-height: 1.65; }
  .house-sources, .house-related { margin-top: clamp(3rem, 6vw, 5rem); padding: clamp(2rem, 5vw, 3.5rem); border-radius: 1rem; }
  .house-sources { background: var(--surface); border: 1px solid var(--line); }
  .house-sources ul { display: grid; gap: 0.7rem; margin: 1.5rem 0 0; padding-left: 1.2rem; color: var(--muted); line-height: 1.6; }
  .house-related { background: var(--surface-alt); }
  .house-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.65rem 1.5rem; margin-top: 1.6rem; }
  .house-links a { color: var(--brand); font-size: 0.88rem; font-weight: 750; }
  .house-links a span { color: var(--accent); text-decoration: none; }

  @media (max-width: 820px) {
    .house-layout { grid-template-columns: 1fr; }
    .house-index { position: static; padding: 1rem 0; border-bottom: 1px solid var(--line); }
    .house-index nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; }
    .house-index a { font-size: 0.82rem; }
    .house-contexts, .house-steps, .house-questions { grid-template-columns: 1fr; }
  }

  @media (max-width: 620px) {
    .house-hero h1 { font-size: clamp(2.8rem, 14vw, 4.8rem); }
    .house-links { grid-template-columns: 1fr; }
  }
</style>
