<div class="cookie-banner" data-cookie-banner hidden role="dialog" aria-labelledby="cookie-banner-title" aria-describedby="cookie-banner-description">
  <div>
    <strong id="cookie-banner-title">Preferenze statistiche</strong>
    <p id="cookie-banner-description">
      Possiamo usare Google Analytics per capire quali contenuti sono utili. È facoltativo e puoi
      rifiutare senza limitazioni alla navigazione.
    </p>
  </div>
  <div class="cookie-banner-actions">
    <a href="/cookie/">Dettagli</a>
    <button class="button button-secondary" type="button" data-cookie-reject>Rifiuta</button>
    <button class="button button-primary" type="button" data-cookie-accept>Accetta statistiche</button>
  </div>
</div>

<script is:inline>
  (() => {
    const consentKey = 'crepeincasa_cookie_consent';
    const banner = document.querySelector('[data-cookie-banner]');

    const readConsent = () => {
      try {
        return window.localStorage.getItem(consentKey);
      } catch {
        return null;
      }
    };

    const writeConsent = (value) => {
      try {
        window.localStorage.setItem(consentKey, value);
      } catch {
        // If storage is unavailable, the choice still applies to this page view.
      }
    };

    const closeBanner = () => {
      if (banner) banner.hidden = true;
    };

    if (!readConsent() && banner) banner.hidden = false;

    document.addEventListener('click', (event) => {
      const clickedElement = event.target instanceof Element ? event.target : null;
      const target = clickedElement?.closest('[data-cookie-accept], [data-cookie-reject], [data-cookie-reset]');
      if (!target) return;

      if (target.matches('[data-cookie-reset]')) {
        try { window.localStorage.removeItem(consentKey); } catch {}
        window.location.reload();
        return;
      }

      writeConsent(target.matches('[data-cookie-accept]') ? 'accepted' : 'rejected');
      closeBanner();

      if (target.matches('[data-cookie-accept]')) window.location.reload();
    });
  })();
</script>

<style>
  .cookie-banner[hidden] { display: none; }
  .cookie-banner {
    position: fixed;
    right: 1rem;
    bottom: 1rem;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem 1.5rem;
    width: min(calc(100% - 2rem), 48rem);
    padding: 1rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 0.85rem;
    background: var(--surface);
    box-shadow: 0 1rem 3rem rgb(33 52 50 / 18%);
  }
  .cookie-banner strong { color: var(--brand-dark); font-size: 0.9rem; }
  .cookie-banner p { max-width: 34rem; margin: 0.35rem 0 0; color: var(--muted); font-size: 0.8rem; line-height: 1.5; }
  .cookie-banner-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: end; gap: 0.55rem; }
  .cookie-banner-actions a { color: var(--brand); font-size: 0.78rem; font-weight: 750; text-underline-offset: 0.2em; }
  .cookie-banner-actions .button { min-height: 2.4rem; padding: 0.55rem 0.8rem; font-size: 0.78rem; }

  @media (max-width: 620px) {
    .cookie-banner { right: 0.75rem; bottom: 0.75rem; grid-template-columns: 1fr; width: calc(100% - 1.5rem); }
    .cookie-banner-actions { justify-content: start; }
  }
</style>
